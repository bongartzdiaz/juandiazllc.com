# /etc/systemd/system/philly-backup.service
#
# Runs the nightly DB dump. Triggered by philly-backup.timer — don't
# start this unit directly in a schedule. `systemctl start` it manually
# to take an ad-hoc backup.
#
# Logs go to the systemd journal:  journalctl -u philly-backup

[Unit]
Description=Philly Dashboard — nightly MariaDB backup
Documentation=file:///root/philly-dashboard/docs/backup-verification.md
# Don't run the dump before the DB is ready on boot
After=network-online.target mariadb.service
Wants=network-online.target
# If mariadb isn't running, fail fast rather than writing a zero-byte dump
Requires=mariadb.service
# Notify on failure via Slack/email (configure in /etc/default/philly-backup)
OnFailure=philly-alert@%n.service

[Service]
Type=oneshot
# Env file drives BACKUP_DIR, DB_NAME, DB_USER, DB_PASS_FILE, S3_BUCKET, etc.
EnvironmentFile=-/etc/default/philly-backup
ExecStart=/usr/local/bin/philly-backup
# Modest hardening — the backup script only needs to read the DB,
# write to BACKUP_DIR, and optionally talk to S3.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/philly /var/log
PrivateTmp=true
# Don't hammer disk/network — nice it down
Nice=10
IOSchedulingClass=idle

[Install]
# Not auto-started on boot — timer handles scheduling
