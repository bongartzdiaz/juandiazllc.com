# /etc/systemd/system/philly-alert@.service
#
# Templated failure-notification unit. Wired into philly-backup.service
# and philly-verify.service via  OnFailure=philly-alert@%n.service
#
# The actual alert logic lives in /usr/local/bin/philly-alert to keep the
# unit file clean (no nested shell escaping). Configure channels in
# /etc/default/philly-backup:
#
#   ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ
#   ALERT_EMAIL=ops@example.com
#
# With neither set, the alert still lands in the journal:
#   journalctl -u 'philly-alert@*' -n 20

[Unit]
Description=Philly Dashboard — failure alert for %i
# Prevent an alert failure from triggering its own alert
StartLimitIntervalSec=0

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/philly-backup
ExecStart=/usr/local/bin/philly-alert %i
# Don't keep the alert process running longer than necessary
TimeoutStartSec=30s
