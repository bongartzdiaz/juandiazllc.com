# Nginx reverse proxy config for Philly Dashboard
# ────────────────────────────────────────────────
# Install:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/philly-dashboard
#   sudo nano /etc/nginx/sites-available/philly-dashboard
#     → Replace DOMAIN.EXAMPLE.COM with your real domain
#   sudo ln -sf /etc/nginx/sites-available/philly-dashboard /etc/nginx/sites-enabled/
#   sudo rm -f /etc/nginx/sites-enabled/default
#   sudo nginx -t
#   sudo systemctl reload nginx
#
# Then get a cert (after DNS has propagated):
#   sudo certbot --nginx -d DOMAIN.EXAMPLE.COM
#
# Certbot will rewrite this file to add the SSL listener + HTTP→HTTPS redirect.

# ── Map: upgrade header for WebSockets / SSE ──
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ── Rate limit zone for the auth endpoint (brute-force guard) ──
# 5 requests per second per IP, burst of 10. Tune to your traffic.
limit_req_zone $binary_remote_addr zone=philly_auth:10m rate=5r/s;

server {
    listen 80;
    listen [::]:80;
    server_name DOMAIN.EXAMPLE.COM;

    # Let certbot challenge files go through before we redirect
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    # Everything else: let certbot add the redirect when you run --nginx
    # (comment this out if you want to serve HTTP during initial bring-up)
    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Long timeouts for SSE (realtime subscriptions) + report generation
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 30s;

        proxy_cache_bypass $http_upgrade;
        proxy_buffering off;           # required for SSE (chunked streams)
    }

    # Tighter rate limit on auth
    location /api/auth/ {
        limit_req zone=philly_auth burst=10 nodelay;

        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # /api/health — bypass rate limit, short timeout so monitors don't hang
    location = /api/health {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        access_log off;
    }

    # Next.js static assets — aggressive cache
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_cache_bypass $http_upgrade;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Security headers (certbot won't touch these)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # HSTS only makes sense once HTTPS is working — uncomment after certbot:
    # add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    # Upload size (documents, images). Bump if you allow larger files.
    client_max_body_size 25M;

    # Gzip for HTML/JSON responses
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/javascript application/xml;
    gzip_min_length 1024;
    gzip_vary on;
}
