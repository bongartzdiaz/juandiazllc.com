# 06-caddy-config.example
# What this does:
#   Caddy 2 reverse-proxy in front of the Next.js app on 127.0.0.1:3000.
#   Auto-TLS via Let's Encrypt (HTTP-01 challenge on :80).
#   HSTS preload, security headers, HTTP/2 + HTTP/3.
#
# Install:
#   1. Replace placeholders below: <APP_DOMAIN> <ACME_EMAIL>
#   2. sudo cp 06-caddy-config.example /etc/caddy/Caddyfile
#   3. sudo caddy validate --config /etc/caddy/Caddyfile
#   4. sudo systemctl reload caddy
#
# Caddyfile syntax — leave the comments alone, they describe the why.

{
  # ACME contact for Let's Encrypt notices.
  email <ACME_EMAIL>

  # Caddy listens on the loopback admin socket only — safer default.
  admin localhost:2019

  # Logs to systemd-journal (we read with `journalctl -u caddy`).
  log {
    output stdout
    format console
    level INFO
  }

  # Trust X-Forwarded-* headers ONLY from these private/loopback ranges.
  # Hetzner doesn't fronted us with their LB so this is just loopback +
  # the box's own private IP (used by the optional Vercel-proxy block
  # below if we ever flip the architecture).
  servers {
    trusted_proxies static 127.0.0.1/32 ::1/128
    metrics
  }
}

# ============================================================
# DEUS app — the CRM at /philly/* and any future paths.
# ============================================================
<APP_DOMAIN> {
  encode zstd gzip

  # Security headers (apply to every response)
  header {
    Strict-Transport-Security  "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options     "nosniff"
    X-Frame-Options            "SAMEORIGIN"
    Referrer-Policy            "strict-origin-when-cross-origin"
    Permissions-Policy         "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    # CSP is enforced inside Next.js via next.config — don't double up.
    -Server
  }

  # Health check used by the operator + UptimeRobot.
  # We don't lb_try_duration here because we have one upstream; let
  # the request fail to surface real errors in logs.
  handle_path /philly/api/health {
    reverse_proxy 127.0.0.1:3000 {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  # All other requests → Next.js. Stream-friendly: no buffering for SSE.
  reverse_proxy 127.0.0.1:3000 {
    header_up Host {host}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}

    # SSE / long-poll friendly
    flush_interval -1

    # Pass through the request body without buffering in Caddy
    # (uploads stream straight to Next.js so memory stays flat).
    transport http {
      keepalive 30s
      keepalive_idle_conns 100
      response_header_timeout 60s
    }
  }
}

# ============================================================
# OPTIONAL — single-domain mode. Uncomment if you keep the brand
# site + CRM on the same vhost (juandiazllc.com → both).
# This proxies everything to Vercel EXCEPT /philly/* which goes
# to the local Next.js app.
#
# We DON'T ship this enabled — the recommended split is:
#   juandiazllc.com  → Vercel (brand site)
#   app.juandiazllc.com → Hetzner (DEUS)
# DNS-split is bulletproof; this proxy block is the fallback if
# DNS-split isn't an option for some reason.
# ============================================================
#
# juandiazllc.com {
#   encode zstd gzip
#
#   # /philly/* → DEUS on this box
#   handle /philly* {
#     reverse_proxy 127.0.0.1:3000 {
#       header_up Host {host}
#       header_up X-Forwarded-Proto {scheme}
#     }
#   }
#
#   # everything else → Vercel
#   handle {
#     reverse_proxy https://cname.vercel-dns.com:443 {
#       header_up Host {host}
#       header_up X-Forwarded-Proto {scheme}
#       transport http {
#         tls
#         tls_server_name cname.vercel-dns.com
#       }
#     }
#   }
# }
