# Bundle DB — track .claude/skills/ + .claude/commands/ in the repo so
# every Claude Code session that opens this project sees the same set
# of slash commands. Worktrees + caches stay ignored.
.claude/worktrees/
.claude/cache/
.claude/sessions/
.claude/projects/
.claude/local/
.claude/state/

# Playwright — browsers land in ~/.cache/ms-playwright (not in repo),
# reports + traces + screenshots are noise that shouldn't be tracked.
playwright-report/
test-results/
playwright/.cache/

