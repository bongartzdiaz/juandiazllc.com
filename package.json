{
  "name": "juandiazllc-com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build --turbopack",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium --with-deps",
    "check:dead": "knip --no-exit-code",
    "check:dead:strict": "knip",
    "analyze": "ANALYZE=true prisma generate && ANALYZE=true next build --no-turbopack",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@prisma/adapter-mariadb": "^7.7.0",
    "@prisma/client": "^7.5.0",
