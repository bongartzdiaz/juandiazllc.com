    "@sentry/react": "^9.47.1",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.45.4",
    "ai": "^6.0.168",
    "bcryptjs": "^3.0.3",
    "d3-geo": "^3.1.1",
    "dotenv": "^17.4.1",
    "lucide-react": "^0.577.0",
    "next": "^16.2.4",
    "next-intl": "^4.8.3",
    "otplib": "^13.4.0",
    "prisma": "^7.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "swr": "^2.4.1",
    "three": "^0.161.0",
    "topojson-client": "^3.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.161.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "geojson": "^0.5.0",
    "knip": "^6.11.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.4"
