# /etc/systemd/system/philly-verify.service
#
# Weekly "does the newest dump actually restore?" check. Non-destructive —
# uses a scratch DB named phily_verify_<timestamp> that gets dropped on exit.
#
# If this fails, it means your nightly backups are silently broken. Alerting
# on its failure is the single most important ops alarm you should wire up.
#
# Logs:  journalctl -u philly-verify

[Unit]
Description=Philly Dashboard — weekly backup verification (restore-to-scratch)
Documentation=file:///root/philly-dashboard/docs/backup-verification.md
After=network-online.target mariadb.service
Wants=network-online.target
Requires=mariadb.service
# This alarm is critical — failure means backups are silently broken
OnFailure=philly-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/philly-backup
# Resolve the latest dump at run time via a shell, then pass it to verify.sh.
# `set -o pipefail` so if `ls` finds nothing we fail loudly instead of
# handing an empty string to verify.sh.
ExecStart=/bin/bash -c 'set -eo pipefail; DUMP=$(ls -1t "${BACKUP_DIR:-/var/backups/philly}"/philly-*.sql.gz 2>/dev/null | head -1); [ -n "$DUMP" ] || { echo "No dumps found in ${BACKUP_DIR:-/var/backups/philly}" >&2; exit 1; }; echo "Verifying: $DUMP"; exec /usr/local/bin/philly-verify "$DUMP"'
# Tighter timeout than backup — a restore that takes >20min means something
# is very wrong (scratch DB runaway, disk full, etc.)
TimeoutStartSec=20m
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/philly /var/log
PrivateTmp=true
Nice=15
IOSchedulingClass=idle

[Install]
# Timer handles scheduling — do not WantedBy anything here
