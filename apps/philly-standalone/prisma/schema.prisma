  city           String   @default("")
  state          String   @default("")
  zipCode        String   @default("")
  country        String   @default("")
  lat            Float?
  lng            Float?
  priceCents     Int      @default(0)
  bedrooms       Int?
  bathrooms      Int?
  sqft           Int?
  yearBuilt      Int?
  description    String   @default("") @db.Text
  features       String   @default("[]") @db.LongText // JSON array
  images         String   @default("[]") @db.LongText // JSON array of URLs
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // RE-specific fields
  listingAgentId String?
  listingDate    DateTime?
  expirationDate DateTime?
  daysOnMarket   Int       @default(0)
  mlsNumber      String    @default("")
  hoaCents       Int       @default(0)
  taxCents       Int       @default(0)
  lotSqft        Int?
  parkingSpaces  Int?
  stories        Int?
  propertyStyle  String    @default("") // colonial, ranch, contemporary, etc.

  // EU pivot 2026-05-26 — energy certification fields.
  // MANDATORY display in EU listings since 2021 (Funda / ImmoScout24
  // require it, agencies fined for missing it). Grades A++ through G
  // per the EU Energy Performance of Buildings Directive (EPBD).
  // Country-specific names: NL "energielabel", DE "Energieausweis",
  // FR "DPE", ES "Certificado Energético", BE "EPC" / "PEB".
  //
  // Nullable on existing data so the migration is non-breaking.
  // UI conditionally shows these only when org.industry === 'real_estate'.
  epcRating      String? // A++, A+, A, B, C, D, E, F, G
  epcExpiresAt   DateTime? // certificates expire after 10 years per EPBD
  virtualTourUrl String    @default("")
  listPriceCents Int       @default(0) // original list price (priceCents = current)
  pricePerSqft   Int       @default(0) // cents

  // DEUS / Cyprus MLS fields
  listingType String  @default("sale") // sale | rent
  subtype     String  @default("") // e.g. detached_house, apartment, penthouse, plot, office, ...
  district    String  @default("") // paphos | limassol | larnaca | nicosia | famagusta
  town        String  @default("") // finer sub-area within district
  isBankOwned Boolean @default(false)
  isResale    Boolean @default(false)

  // Bundle BR — manual reorder column. Mirrors Contact.displayOrder
  // (Bundle AG) and Deal.displayOrder (Bundle AL). NULL = unsorted
  // (server's default order wins). The grid renders ascending; the
  // /api/properties/reorder endpoint writes 1..N inside a transaction.
  displayOrder BigInt?

  organization   Organization    @relation(fields: [organizationId], references: [id])
  viewings       Viewing[]
  deals          Deal[]
  offers         Offer[]
  openHouses     OpenHouse[]
  showings       Showing[]
  portalListings PortalListing[]

  @@index([organizationId, status])
  @@index([organizationId, mlsNumber])
  @@index([organizationId, listingType, district])
  @@index([organizationId, displayOrder])
  @@index([organizationId, type, subtype])
}

/// EU portal publish targets. One Property row can have multiple
/// PortalListing rows (publish the same property to Funda + IS24 +
/// Immoweb in one click) — each row carries the portal's external
/// id so re-publish is idempotent and unpublish is exact.
///
/// Added 2026-05-27 along with the Funda + IS24 connector scaffolds
/// (tasks #12, #14). The actual publish-route in
/// app/api/properties/[id]/publish/route.ts upserts on
/// (organizationId, propertyId, portal) so a second publish updates
/// the existing row instead of creating a duplicate.
model PortalListing {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String
  /// 'funda' | 'immoscout24' | 'immoweb' | 'idealista' | 'seloger'
  portal         String
  /// The portal's own listing id — Funda's listingId, IS24's exposeId.
  externalId     String
  /// Public-facing URL on the portal once published.
  externalUrl    String?
  /// 'draft' | 'published' | 'pulled' | 'rejected'
  status         String    @default("draft")
  /// When the most recent sync to/from the portal succeeded.
  lastSyncAt     DateTime?
  /// If the last operation failed, the localised error code (e.g.
  /// FUNDA_EPC_REQUIRED) for the operator to see in the UI.
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Globally-unique on (portal, externalId) — Funda assigns one id
  /// per listing, IS24 same. This is how we dedupe webhook events
  /// back to a Property.
  @@unique([portal, externalId])
  /// Upsert key for the publish route — one row per
  /// (org, property, portal) combination.
  @@unique([organizationId, propertyId, portal])
  @@index([organizationId, portal])
  @@index([propertyId])
}

