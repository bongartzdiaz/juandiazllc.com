generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  industry  String   @default("general")
  createdAt DateTime @default(now())

  users                  User[]
  projects               Project[]
  contacts               Contact[]
  kanbanBoards           KanbanBoard[]
  customPages            CustomPage[]
  auditLogs              AuditLog[]
  savedViews             SavedView[]
  pipelines              Pipeline[]
  calendarEvents         CalendarEvent[]
  notifications          Notification[]
  automations            AutomationRule[]
  webhooks               Webhook[]
  apiKeys                ApiKey[]
  templates              Template[]
  documents              Document[]
  properties             Property[]
  rooms                  Room[]
  grants                 Grant[]
  donorProfiles          DonorProfile[]
  volunteers             Volunteer[]
  mlsFeeds               MlsFeed[]
  listingAlerts          ListingAlert[]
  conversations          Conversation[]
  leadScores             LeadScore[]
  scoringRules           ScoringRule[]
  leadRoutingRules       LeadRoutingRule[]
  callLogs               CallLog[]
  dialerLists            DialerList[]
  actionPlans            ActionPlan[]
  transactions           Transaction[]
  referrals              Referral[]
  soiCategories          SoiCategory[]
  cmaReports             CmaReport[]
  clientPortalAccess     ClientPortalAccess[]
  emailAccounts          EmailAccount[]
  smsMessages            SmsMessage[]
  integrations           Integration[]
  propertyTaxonomy       PropertyTaxonomy?
  // Multi-org: every user that belongs to this organization is
  // represented by a Membership row. A user's User.organizationId is
  // their primary/home org; membership in additional orgs is purely
  // through this table.
  memberships            Membership[]
  gdprErasureLogs        GdprErasureLog[]
  gdprExportLogs         GdprExportLog[]
  gdprConsentRecords     GdprConsentRecord[]
  assistantConversations AssistantConversation[]
  assistantMemories      AssistantMemory[]
  featureFlags           FeatureFlag[]
  orgFeatureOverrides    OrgFeatureOverride[]
  scimGroups             ScimGroup[]
  dripEnrollments        DripEnrollment[]

  // Enterprise — per-org access controls. NULL on both = no
  // restrictions (default). Both can be set via the admin Security
  // settings page; updates are audit-logged.
  //
  // ipAllowlist: comma-separated CIDR ranges. If non-null,
  //   requireScope rejects with 403 when the request's client IP is
  //   not in any of the listed ranges. Loopback + RFC1918 are NEVER
  //   auto-allowed — the admin chooses what to trust.
  //
  // sessionIdleTimeoutMinutes: if set, sessions older than this many
  //   minutes since User.lastActivityAt are rejected (forces
  //   re-authentication).
  ipAllowlist               String? @db.Text
  sessionIdleTimeoutMinutes Int?

  // Bundle CX — billing. One subscription per org, optional (e.g. demo
  // tenants and Enterprise-contract orgs have no Stripe subscription).
  subscription Subscription?
}

// Bundle CX — Stripe subscription mirror. We don't store invoice
// history here (Stripe is the source of truth for receipts); we
// store just enough to gate feature access + show plan/status in
// the CRM. Subscription lifecycle events arrive via the webhook
// route at /api/webhooks/stripe.
model Subscription {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stripeCustomerId     String  @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  // 'operator' | 'team' | 'business' — matches the pricing.* keys
  // in lib/i18n/dict.ts on the marketing side.
  plan String

  // Stripe values: 'trialing' | 'active' | 'past_due' | 'canceled' |
  // 'incomplete' | 'incomplete_expired' | 'unpaid' | 'paused'.
  status String

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  trialEndsAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([currentPeriodEnd])
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  emailVerified       DateTime?
  name                String
  passwordHash        String
  role                String    @default("viewer") // admin, manager, viewer, superAdmin
  // role notes:
  //   - viewer      : read-only org member
  //   - manager     : mutation rights within own org
  //   - admin       : full org-level rights (settings, billing, users)
  //   - superAdmin  : PLATFORM-LEVEL — Juan / lucenai.eu staff. Bypasses
  //     org boundaries via auth-helpers.ts requireSuperAdmin(). Used by
  //     the two-level feature-toggle UX (lib/philly/features/resolve.ts)
  //     to write OrgFeatureOverride rows that force a feature ON/OFF
  //     for a specific org, bypassing the plan-tier check when needed.
  // Per-user dashboard-section allow-list. Null = full access
  // (superadmin / legacy users). Array of slugs from
  // lib/philly/sections.ts = strict allow-list. `role === 'admin'`
  // bypasses this regardless (admins can't lock themselves out).
  dashboardSections   Json?
  locale              String    @default("en")
  avatarUrl           String?
  image               String?
  organizationId      String
  createdAt           DateTime  @default(now())
  // Security: brute-force lockout
  failedLoginCount    Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  // Updated on every authenticated request via touchActivity() in
  // requireScope. Used by the per-org sessionIdleTimeoutMinutes
  // policy to force re-authentication on stale sessions.
  lastActivityAt      DateTime?
  // Security: global session invalidation — any JWT issued before this
  // timestamp is rejected. Bump this to log the user out on all devices.
  tokensInvalidAfter  DateTime?
  // GDPR Art. 17 — when set, account is scheduled for deletion at this
  // timestamp. Reads/writes from this user are blocked once set; the
  // retention cron hard-deletes the row when `now() >= deletionScheduledAt`.
  deletionScheduledAt DateTime?
  deletionRequestedAt DateTime?
  // TOTP two-factor auth
  twoFactorSecret     String? // encrypted via src/lib/crypto.ts
  twoFactorEnabled    Boolean   @default(false)
  twoFactorVerifiedAt DateTime?
  // SCIM externalId — the IdP's stable identifier for this user
  // (e.g. "okta-00u4abc123"). Persisted on POST + PUT + PATCH so
  // de-provisioning by externalId works without round-tripping
  // email. Null when the user wasn't SCIM-provisioned.
  // Bundle BQ; RFC 7644 §3.4 (filter by externalId).
  scimExternalId      String?

  organization               Organization            @relation(fields: [organizationId], references: [id])
  // Multi-org membership. organizationId above is the user's "home"
  // (primary) org — the one they were originally created in. The
  // Membership rows enumerate every org they belong to with the role
  // and section-allow-list per org. The active org for a given
  // request is resolved by lib/philly/auth-helpers.ts from a cookie
  // (`philly-active-org`), falling back to organizationId when unset.
  memberships                Membership[]
  scimGroupMemberships       ScimGroupMembership[]
  twoFactorRecoveryCodes     TwoFactorRecoveryCode[]
  dashboardLayout            DashboardLayout?
  kanbanCards                KanbanCard[]            @relation("assignee")
  customPages                CustomPage[]
  accounts                   Account[]
  sessions                   Session[]
  auditLogs                  AuditLog[]
  contactNotes               ContactNote[]
  activities                 Activity[]
  savedViews                 SavedView[]
  notifications              Notification[]
  automationLogs             AutomationLog[]
  eventAttendees             EventAttendee[]
  reports                    Report[]
  deals                      Deal[]                  @relation("dealOwner")
  assistantConversations     AssistantConversation[]
  assistantMemories          AssistantMemory[]
  // Bundle DEUS — super-admin actions. NULL for non-superAdmin users.
  orgFeatureOverridesCreated OrgFeatureOverride[]    @relation("OrgFeatureOverrideCreator")

  @@index([organizationId, scimExternalId])
}

model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String // bcrypt hash of the one-time code
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── NextAuth tables (PrismaAdapter compatible) ──

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id             String    @id @default(cuid())
  title          String
  description    String    @default("") @db.Text
  status         String    @default("planned") // planned, active, completed, paused
  category       String    @default("general")
  startDate      DateTime
  endDate        DateTime?
  budgetCents    Int       @default(0)
  spentCents     Int       @default(0)
  sdgGoals       Json      @default("[]") // SDG numbers 1-17 as JSON array (MySQL has no native int[])
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id])
  milestones      ProjectMilestone[]
  impactMetrics   ImpactMetric[]
  contactProjects ContactProject[]
  kanbanCards     KanbanCard[]
  deals           Deal[]
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  dueDate     DateTime
  completedAt DateTime?
  status      String    @default("pending") // pending, completed, overdue

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Contact {
  id             String   @id @default(cuid())
  name           String
  // email / phone — at-rest encrypted (Bundle P, AES-256-GCM via
  // lib/philly/pii.ts with the `enc:v1:` prefix). Searchable via
  // the *Hash columns below: HMAC-SHA-256 of the normalised value
  // using BLIND_INDEX_SECRET. Lookups are by hash (exact match,
  // indexed); the actual value is decrypted on read.
  email          String   @default("")
  phone          String   @default("")
  emailHash      String?  @db.VarChar(64)
  phoneHash      String?  @db.VarChar(64)
  type           String   @default("stakeholder") // partner, beneficiary, stakeholder, donor, buyer, seller, tenant, landlord
  company        String   @default("")
  notes          String   @default("") @db.Text
  avatarUrl      String?
  organizationId String
  createdAt      DateTime @default(now())

  // RE Lead fields
  leadScore       Int       @default(0) // 0-100 behavioral score
  leadSource      String    @default("") // canonical list in lib/philly/contacts/lead-sources.ts — EU pivot 2026-05-26 moved from US-only (zillow/realtor_com) to EU-portal coverage (funda, immoscout24, idealista, seloger, logic_immo, immoweb) + universal sources (website, referral, open_house, facebook, google, cold_call, sphere, email_campaign)
  leadStatus      String    @default("new") // new, contacted, qualified, nurture, hot, under_contract, closed, lost
  preferredMethod String    @default("email") // email, phone, text, whatsapp
  preApproved     Boolean   @default(false)
  preApprovalAmt  Int       @default(0) // cents
  buyerPriceMin   Int? // cents
  buyerPriceMax   Int? // cents
  buyerBeds       Int?
  buyerBaths      Int?
  buyerAreas      String    @default("") // comma-separated zip codes or neighborhoods
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  assignedToId    String?

  // AI-derived attributes (Attio-style) — filled by lib/philly/ai/contact-attributes
  // on contact create and on-demand refresh via /api/contacts/[id]/ai-attributes.
  // Deterministic scoring still lives in LeadScore; these are LLM-inferred.
  aiIndustry            String? // e.g. "Residential solar", "SaaS — devtools"
  aiIcpFit              Int? // 0-100 match against ideal customer profile
  aiSummary             String?   @db.Text // one-paragraph narrative summary
  aiAttributesStatus    String? // "pending" | "ready" | "error" (null = never run)
  aiAttributesUpdatedAt DateTime?
  aiAttributesError     String?   @db.Text // last error message if status=error

  // Bundle AG — manual ordering for the contacts list. NULL means
  // "use createdAt fallback"; explicit values sort lower-first. The
  // reorder endpoint writes monotonically increasing integers from
  // a base of (createdAt epoch ms) so insertions don't require a
  // global rewrite.
  displayOrder BigInt?

  organization    Organization     @relation(fields: [organizationId], references: [id])
  contactProjects ContactProject[]
  contactNotes    ContactNote[]
  dripEnrollments DripEnrollment[]
  activities      Activity[]
  deals           Deal[]
  offers          Offer[]
  openHouseVisits OpenHouseVisit[]

  @@index([organizationId, createdAt])
  @@index([organizationId, leadScore])
  @@index([organizationId, leadStatus])
  @@index([organizationId, emailHash])
  @@index([organizationId, phoneHash])
  @@index([organizationId, displayOrder])
  @@index([assignedToId])
}

model ContactProject {
  id        String @id @default(cuid())
  contactId String
  projectId String
  role      String @default("member")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([contactId, projectId])
}

model ImpactMetric {
  id         String   @id @default(cuid())
  projectId  String
  metricType String // co2_kg, people_helped, trees_planted, money_donated, water_liters, energy_kwh, custom
  value      Float
  unit       String   @default("")
  date       DateTime @default(now())
  notes      String   @default("") @db.Text

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model KanbanBoard {
  id             String   @id @default(cuid())
  title          String
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id])
  columns      KanbanColumn[]
}

model KanbanColumn {
  id       String @id @default(cuid())
  boardId  String
  title    String
  position Int
  color    String @default("#94A3B8")

  board KanbanBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards KanbanCard[]
}

model KanbanCard {
  id          String    @id @default(cuid())
  columnId    String
  projectId   String?
  title       String
  description String    @default("") @db.Text
  position    Int
  priority    String    @default("medium") // low, medium, high, urgent
  dueDate     DateTime?
  assigneeId  String?

  column   KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  project  Project?     @relation(fields: [projectId], references: [id])
  assignee User?        @relation("assignee", fields: [assigneeId], references: [id])

  @@index([columnId])
  @@index([projectId])
  @@index([assigneeId])
}

model DashboardLayout {
  id          String   @id @default(cuid())
  userId      String   @unique
  widgetsJson String   @default("[]") @db.LongText // JSON string of DashboardWidget[]
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomPage {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  slug           String
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  creator      User         @relation(fields: [createdBy], references: [id])
  blocks       PageBlock[]

  @@unique([organizationId, slug])
}

model PageBlock {
  id       String @id @default(cuid())
  pageId   String
  type     String // text, table, chart, embed, kanban, image
  content  String @default("{}") @db.LongText // JSON content
  position Int

  page CustomPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

// ── Phase 1: Audit & Data Integrity ──

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  action         String // create, update, delete
  entity         String // project, contact, kanbanCard, etc.
  entityId       String?
  changes        String   @default("{}") @db.LongText // JSON diff {field: {old, new}}
  createdAt      DateTime @default(now())
  // Tamper-evident hash chain — see lib/philly/audit.ts.
  // prevHash = most recent existing row's hash for the same organizationId
  //            (null for the first row in the chain).
  // hash     = SHA-256 hex digest of (prevHash || canonicalJson(row)).
  // Both nullable so legacy rows pre-dating the chain remain readable;
  // verifier flags them as `unhashed` rather than `tampered`.
  prevHash       String?  @db.VarChar(64)
  hash           String?  @db.VarChar(64)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@index([organizationId, hash])
}

// ── Phase 2A: Contact 360 ──

model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([contactId, createdAt])
  @@index([userId])
}

model Activity {
  id             String   @id @default(cuid())
  organizationId String?
  contactId      String?
  userId         String?
  type           String // note, email, call, meeting, task, deal_update, status_change
  title          String
  description    String   @default("") @db.Text
  metadata       String   @default("{}") @db.LongText // JSON extra data
  createdAt      DateTime @default(now())

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id])

  @@index([contactId, createdAt])
  @@index([userId, createdAt])
}

// ── Phase 2B: Saved Views ──

model SavedView {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  entity         String // contacts, projects, deals
  name           String
  filtersJson    String   @default("[]") @db.LongText // JSON filter rules
  columnsJson    String   @default("[]") @db.LongText // visible columns
  sortJson       String   @default("{}") @db.LongText // sort config
  isDefault      Boolean  @default(false)
  isShared       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, entity])
}

// ── Phase 2C: Pipeline & Deals ──

model Pipeline {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  industry       String   @default("general") // philanthropy, realestate, hospitality
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id])
  stages       PipelineStage[]
  deals        Deal[]

  @@index([organizationId])
}

model PipelineStage {
  id         String @id @default(cuid())
  pipelineId String
  name       String
  position   Int
  color      String @default("#94A3B8")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId])
}

/// Bundle AL — manual ordering for the deals list view. NULL = unordered
/// (fall back to createdAt desc); explicit values sort lower-first. Index
/// is (pipelineId, displayOrder) so reorder queries stay cheap inside one
/// pipeline.
model Deal {
  id            String    @id @default(cuid())
  pipelineId    String
  stageId       String
  contactId     String?
  projectId     String?
  propertyId    String?
  ownerId       String?
  title         String
  valueCents    Int       @default(0)
  currency      String    @default("USD")
  probability   Int       @default(50) // 0-100
  status        String    @default("open") // open, won, lost
  dealType      String    @default("buy") // buy, sell, rent, lease, dual
  expectedClose DateTime?
  actualClose   DateTime?
  notes         String    @default("") @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Commission tracking
  commissionPct      Float @default(3.0) // agent commission %
  commissionCents    Int   @default(0) // calculated commission
  brokerSplitPct     Float @default(30.0) // brokerage split %
  teamSplitPct       Float @default(0) // team lead split %
  referralFeePct     Float @default(0) // referral fee %
  netCommissionCents Int   @default(0) // after all splits
  earnestMoneyCents  Int   @default(0)

  // Transaction management
  inspectionDate       DateTime?
  appraisalDate        DateTime?
  titleDate            DateTime?
  finalWalkDate        DateTime?
  closingDate          DateTime?
  contingenciesJson    String    @default("[]") @db.LongText // JSON array of {name, status, dueDate}
  closingChecklistJson String    @default("[]") @db.LongText // JSON array of {task, done, dueDate}

  // Manual ordering for the deals LIST view (Bundle AL). NULL falls
  // back to createdAt-desc; explicit values sort lower-first.
  displayOrder BigInt?

  // Source tracking
  leadSource String @default("")

  pipeline Pipeline      @relation(fields: [pipelineId], references: [id])
  stage    PipelineStage @relation(fields: [stageId], references: [id])
  contact  Contact?      @relation(fields: [contactId], references: [id])
  project  Project?      @relation(fields: [projectId], references: [id])
  property Property?     @relation(fields: [propertyId], references: [id])
  owner    User?         @relation("dealOwner", fields: [ownerId], references: [id])
  offers   Offer[]

  @@index([pipelineId, stageId])
  @@index([pipelineId, displayOrder])
  @@index([contactId])
  @@index([propertyId])
  @@index([status])
}

// ── Phase 2D: Calendar Events ──

model CalendarEvent {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  description    String   @default("") @db.Text
  startTime      DateTime
  endTime        DateTime
  allDay         Boolean  @default(false)
  location       String   @default("")
  color          String   @default("#3B82F6")
  recurrence     String? // RRULE string or null
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  attendees    EventAttendee[]

  @@index([organizationId, startTime])
}

model EventAttendee {
  id      String  @id @default(cuid())
  eventId String
  userId  String?
  email   String  @default("")
  status  String  @default("pending") // pending, accepted, declined

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User?         @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// ── Phase 2E: Reports ──

model Report {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String
  title          String
  type           String // quarterly, financial, sdg, impact, custom
  status         String   @default("generating") // generating, ready, failed
  configJson     String   @default("{}") @db.LongText
  resultHtml     String?  @db.LongText
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ── Phase 2F: Notifications ──

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  type           String // info, warning, success, error
  title          String
  message        String   @default("") @db.Text
  link           String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([userId, read, createdAt])
  @@index([organizationId, createdAt])
}

// ── Phase 3: Automation ──

model AutomationRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  trigger        String // onEntityCreate, onFieldChange, onStageChange, onSchedule, onDateApproach
  triggerConfig  String   @default("{}") @db.LongText
  actionType     String // sendEmail, sendSMS, createTask, updateField, moveStage, createNotification, callWebhook
  actionConfig   String   @default("{}") @db.LongText
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id])
  automationLogs AutomationLog[]

  @@index([organizationId, enabled])
}

model AutomationLog {
  id        String   @id @default(cuid())
  ruleId    String
  userId    String?
  status    String // success, failure
  input     String   @default("{}") @db.LongText
  output    String   @default("{}") @db.LongText
