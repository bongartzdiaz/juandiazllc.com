// ── Email Integration ──

model EmailAccount {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  provider       String   @default("smtp") // smtp, gmail, outlook
  email          String
  displayName    String   @default("")
  smtpHost       String   @default("")
  smtpPort       Int      @default(587)
  imapHost       String   @default("")
  imapPort       Int      @default(993)
  username       String   @default("")
  encryptedPass  String   @default("") @db.Text
  accessToken    String?  @db.Text
  refreshToken   String?  @db.Text
  tokenExpiry    DateTime?
  syncEnabled    Boolean  @default(true)
  lastSyncAt     DateTime?
  status         String   @default("active") // active, error, disconnected
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  emails       Email[]
  threads      EmailThread[]

  @@index([organizationId])
  @@index([userId])
}

// Gmail/Outlook thread grouping. One row per provider thread id; lets us
// render conversation view + track last-sync watermark per thread without
// touching every Email row. `providerThreadId` is the raw id the provider
// gave us (Gmail: `threadId` on messages; IMAP: we derive from References).
model EmailThread {
  id                String   @id @default(cuid())
  accountId         String
  providerThreadId  String   @db.VarChar(255)
  contactId         String?
  subject           String   @default("")
  snippet           String   @default("") @db.Text
  participants      String   @default("[]") @db.Text // JSON string[] of email addrs
  messageCount      Int      @default(0)
  unreadCount       Int      @default(0)
  lastMessageAt     DateTime?
  lastSyncedAt      DateTime?
  labels            String   @default("[]") @db.Text // JSON string[] (Gmail labels)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account  EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages Email[]

  @@unique([accountId, providerThreadId])
  @@index([accountId])
  @@index([contactId])
  @@index([lastMessageAt])
}

model Email {
  id             String   @id @default(cuid())
  accountId      String
  threadRowId    String?  // FK → EmailThread.id (optional during migration)
  contactId      String?
  messageId      String?  @db.VarChar(512) // RFC Message-ID
  threadId       String?  // Provider thread id (Gmail threadId). Kept for dedupe + back-compat.
  direction      String   @default("outbound") // inbound, outbound
  fromAddress    String
  toAddresses    String   @db.Text // JSON array
  ccAddresses    String   @default("[]") @db.Text
  bccAddresses   String   @default("[]") @db.Text
  subject        String   @default("")
  snippet        String   @default("") @db.Text
  bodyHtml       String?  @db.LongText
  bodyText       String?  @db.LongText
  labels         String   @default("[]") @db.Text // JSON string[] (Gmail labels or IMAP flags)
  status         String   @default("draft") // draft, queued, sent, delivered, bounced, failed, received
  openedAt       DateTime?
  clickedAt      DateTime?
  bouncedAt      DateTime?
  sentAt         DateTime?
  receivedAt     DateTime?
  createdAt      DateTime @default(now())

  account EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  thread  EmailThread? @relation(fields: [threadRowId], references: [id], onDelete: SetNull)

  // Dedupe across sync runs. Gmail re-emits the same message id when a
  // thread gets fetched multiple times; this constraint makes upsert safe.
  @@unique([accountId, messageId])
  @@index([accountId])
  @@index([contactId])
  @@index([threadId])
  @@index([threadRowId])
  @@index([status])
}

// ── SMS / WhatsApp ──

model SmsMessage {
  id             String   @id @default(cuid())
  organizationId String
  contactId      String?
  direction      String   @default("outbound") // inbound, outbound
  channel        String   @default("sms") // sms, whatsapp
  fromNumber     String
  toNumber       String
  body           String   @db.Text
  status         String   @default("queued") // queued, sent, delivered, failed, received
  providerSid    String?  // Twilio SID
  errorCode      String?
  errorMessage   String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([contactId])
  @@index([status])
}

// ── Integration / OAuth ──

model Integration {
  id             String   @id @default(cuid())
  organizationId String
  provider       String   // google, microsoft, slack, stripe, mailchimp, etc.
  name           String
  status         String   @default("disconnected") // connected, disconnected, error
  accessToken    String?  @db.Text
  refreshToken   String?  @db.Text
  tokenExpiry    DateTime?
  scopes         String   @default("[]") @db.Text // JSON array
  metadata       String   @default("{}") @db.Text // provider-specific config
  lastSyncAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider])
  @@index([organizationId])
}

/* ---------------- Property Taxonomy (per-organization) ----------------
   Each org can customize districts, property types, subtypes, and flags.
   All JSON fields store the same shapes as the Cyprus defaults in
   src/lib/constants/cyprus-property.ts so the UI can consume either. */
model PropertyTaxonomy {
  id             String   @id @default(cuid())
  organizationId String   @unique
  // Country context (just metadata for UI — e.g. "Cyprus", "Netherlands")
  countryLabel   String   @default("Cyprus")

  // All JSON — array<{value,label}> or map<type, array<{value,label}>>
  districts      String   @default("[]") @db.LongText
  propertyTypes  String   @default("[]") @db.LongText
  subtypes       String   @default("{}") @db.LongText // keyed by propertyType value
  listingTypes   String   @default("[]") @db.LongText
  flags          String   @default("[]") @db.LongText // array<{key,label}>

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// ── GDPR — Art. 15 / 17 / 30 ──────────────────────────────────────
//
// Three append-only tables that satisfy data-subject-rights audit
// obligations without retaining the personal data themselves. We
// store HASHES of identifiers (subjectEmailHash) so we can prove
// "we erased X's data on Y" to a regulator without keeping X's email
// after erasure. Hashing function: SHA-256 over the lowercased email.

/// Subject Access Request export audit. One row per data export
/// triggered (self-export or admin-led). Retain for 6 years to
/// match standard contractual claim windows.
model GdprExportLog {
  id                String   @id @default(cuid())
  organizationId    String
  /// Operator who triggered the export. Null for cron / system.
  actorUserId       String?
  /// Sha-256 of lowercased email of the data subject the export was about.
  /// Equal to actorUserId's email hash for self-exports.
  subjectEmailHash  String
  /// 'self' (operator exported their own data) | 'admin' (operator
  /// exported a contact's data on the contact's request).
  channel           String
  /// Number of rows included in the export, by model — JSON.
  /// Example: {"User":1,"Contact":3,"Reservation":12}
  rowCounts         String   @db.Text
  /// IP of the actor at export time, for forensics.
  actorIp           String?
  createdAt         DateTime @default(now())

  organization      Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([subjectEmailHash])
}

/// Right-to-erasure audit. Retains forever — proof of erasure must
/// outlive the data itself. The `subjectEmailHash` is a one-way SHA-256
/// hash so the regulator can verify a specific person's data was erased
/// (by hashing their email and looking up this table) without us
/// retaining the email.
model GdprErasureLog {
  id                String   @id @default(cuid())
  organizationId    String
  actorUserId       String?
  subjectEmailHash  String
  /// 'self' (user deleted own account) | 'admin' (admin erased a
  /// contact's data on request) | 'retention' (auto-purge by cron).
  channel           String
  /// Comma-separated list of Prisma model names erased.
  modelsErased      String   @db.Text
  /// Number of rows erased per model — JSON, e.g. {"Contact":2,"Message":17}
  rowCounts         String   @db.Text
  /// Optional human-readable note (e.g. ticket number).
  reason            String?  @db.Text
  actorIp           String?
  createdAt         DateTime @default(now())

  organization      Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([subjectEmailHash])
}

/// Consent record for processing operations that rely on Art. 6(1)(a)
/// consent. Volunteer signups, marketing opt-in, etc. Append-only;
/// withdrawal is recorded as a new row with `withdrawn = true`.
model GdprConsentRecord {
  id                String   @id @default(cuid())
  organizationId    String
  /// Sha-256 of lowercased email of the data subject.
  subjectEmailHash  String
  /// Stable identifier for the processing activity, matching a key in
  /// lib/gdpr/ropa.ts. Examples: 'volunteer_roster', 'marketing_email'.
  purpose           String
  granted           Boolean  @default(true)
  withdrawn         Boolean  @default(false)
  /// Free text capturing what was shown to the data subject when they
  /// gave consent. Required for proof-of-consent under Art. 7.
  noticeShown       String?  @db.Text
  ipAddress         String?
  userAgent         String?  @db.Text
  createdAt         DateTime @default(now())

  organization      Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, subjectEmailHash])
  @@index([purpose, createdAt])
}
