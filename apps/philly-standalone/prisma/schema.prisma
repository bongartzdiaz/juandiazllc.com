/**
 * ---------------- Property Taxonomy (per-organization) ----------------
 * Each org can customize districts, property types, subtypes, and flags.
 * All JSON fields store the same shapes as the Cyprus defaults in
 * src/lib/constants/cyprus-property.ts so the UI can consume either.
 */
model PropertyTaxonomy {
  id             String @id @default(cuid())
  organizationId String @unique
  // Country context (just metadata for UI — e.g. "Cyprus", "Netherlands")
  countryLabel   String @default("Cyprus")

  // All JSON — array<{value,label}> or map<type, array<{value,label}>>
  districts     String @default("[]") @db.LongText
  propertyTypes String @default("[]") @db.LongText
  subtypes      String @default("{}") @db.LongText // keyed by propertyType value
  listingTypes  String @default("[]") @db.LongText
  flags         String @default("[]") @db.LongText // array<{key,label}>

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// ── GDPR — Art. 15 / 17 / 30 ──────────────────────────────────────
//
// Three append-only tables that satisfy data-subject-rights audit
// obligations without retaining the personal data themselves. We
// store HASHES of identifiers (subjectEmailHash) so we can prove
// "we erased X's data on Y" to a regulator without keeping X's email
// after erasure. Hashing function: SHA-256 over the lowercased email.

/// Subject Access Request export audit. One row per data export
/// triggered (self-export or admin-led). Retain for 6 years to
/// match standard contractual claim windows.
model GdprExportLog {
  id               String   @id @default(cuid())
  organizationId   String
  /// Operator who triggered the export. Null for cron / system.
  actorUserId      String?
  /// Sha-256 of lowercased email of the data subject the export was about.
  /// Equal to actorUserId's email hash for self-exports.
  subjectEmailHash String
  /// 'self' (operator exported their own data) | 'admin' (operator
  /// exported a contact's data on the contact's request).
  channel          String
  /// Number of rows included in the export, by model — JSON.
  /// Example: {"User":1,"Contact":3,"Reservation":12}
  rowCounts        String   @db.Text
  /// IP of the actor at export time, for forensics.
  actorIp          String?
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([subjectEmailHash])
}

/// Right-to-erasure audit. Retains forever — proof of erasure must
/// outlive the data itself. The `subjectEmailHash` is a one-way SHA-256
/// hash so the regulator can verify a specific person's data was erased
/// (by hashing their email and looking up this table) without us
/// retaining the email.
model GdprErasureLog {
  id               String   @id @default(cuid())
  organizationId   String
  actorUserId      String?
  subjectEmailHash String
  /// 'self' (user deleted own account) | 'admin' (admin erased a
  /// contact's data on request) | 'retention' (auto-purge by cron).
  channel          String
  /// Comma-separated list of Prisma model names erased.
  modelsErased     String   @db.Text
  /// Number of rows erased per model — JSON, e.g. {"Contact":2,"Message":17}
  rowCounts        String   @db.Text
  /// Optional human-readable note (e.g. ticket number).
  reason           String?  @db.Text
  actorIp          String?
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([subjectEmailHash])
}

/// Consent record for processing operations that rely on Art. 6(1)(a)
/// consent. Volunteer signups, marketing opt-in, etc. Append-only;
/// withdrawal is recorded as a new row with `withdrawn = true`.
model GdprConsentRecord {
  id               String   @id @default(cuid())
  organizationId   String
  /// Sha-256 of lowercased email of the data subject.
  subjectEmailHash String
  /// Stable identifier for the processing activity, matching a key in
  /// lib/gdpr/ropa.ts. Examples: 'volunteer_roster', 'marketing_email'.
  purpose          String
  granted          Boolean  @default(true)
  withdrawn        Boolean  @default(false)
  /// Free text capturing what was shown to the data subject when they
  /// gave consent. Required for proof-of-consent under Art. 7.
  noticeShown      String?  @db.Text
  ipAddress        String?
  userAgent        String?  @db.Text
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, subjectEmailHash])
  @@index([purpose, createdAt])
}

// ── In-app AI assistant ────────────────────────────────────────────
//
// The assistant runs against a self-hosted Ollama box (Qwen 2.5 by
// default). Conversation history persists per user; structured
// "memory" facts are key/value rows the assistant can write to
// remember things across chats (preferred language, onboarding
// stage, etc.). All data here is org-scoped.

model AssistantConversation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String   @default("Untitled chat")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  user         User            @relation(fields: [userId], references: [id])
  turns        AssistantTurn[]

  @@index([organizationId, userId, updatedAt])
}

model AssistantTurn {
  id               String   @id @default(cuid())
  conversationId   String
  role             String // 'user' | 'assistant' | 'system'
  content          String   @db.LongText
  /// JSON array of {slug, score} for KB chunks the assistant retrieved
  /// for this turn. Surfaced as citations in the UI.
  retrievedDocs    String   @default("[]") @db.Text
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  /// Model identifier (e.g. 'qwen2.5:14b-instruct-q4_K_M') so we can
  /// audit answer quality across model upgrades.
  model            String?
  createdAt        DateTime @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AssistantMemory {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  /// Stable key namespace, e.g. 'pref.language', 'onboarding.stage'.
  /// Unique per user; writing the same key twice updates in place.
  key            String
  value          String   @db.Text
  /// Optional pointer to the AssistantTurn that wrote this memory.
  sourceTurnId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([userId, key])
  @@index([organizationId, userId])
}

// ── Multi-org membership (Bundle G) ───────────────────────────────
//
// One row per (user, organization) pair. The user's permissions
// inside that org live here. User.organizationId above is the
// user's "home" (primary) org — the one they were created in —
// and the canonical role/sections for that org. Memberships in
// OTHER orgs add additional org access.
//
// Composite unique on (userId, organizationId) — at most one
// membership per (user, org) pair.
//
// Indexes optimised for the two hot paths:
//   - "what orgs does this user belong to?" → @@index([userId])
//   - "who is in this org?"                 → @@index([organizationId, role])

model Membership {
  id                String   @id @default(cuid())
  userId            String
  organizationId    String
  /// Role in THIS organization. Independent of User.role (which is
  /// the home-org role). admin / manager / viewer.
  role              String   @default("viewer")
  /// Per-org dashboard-section allow-list. Same shape as
  /// User.dashboardSections (null = full access, JSON array = list).
  dashboardSections Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId, role])
}

// FeatureFlag — per-org kill-switch for runtime feature toggling
// without redeploy. organizationId NULL = global default that applies
// to every org until they override locally. Resolution order:
//   org-specific row → global default → enabledByDefault (code constant)
//
// Use cases:
//   - Kill AI enrichment if it misbehaves (no redeploy needed)
//   - Disable webhooks during a migration window
//   - Roll out a new feature to one customer at a time
//   - Emergency-disable a route under attack
//
// Reads are cached for 60s (lib/philly/features.ts) so a hot path
// doesn't pay a DB round-trip on every call.
model FeatureFlag {
  id             String   @id @default(cuid())
  /// NULL = global default; otherwise scoped to a specific org.
  organizationId String?
  /// Stable string key from FEATURES const (lib/philly/features.ts).
  key            String
  enabled        Boolean  @default(true)
  /// Free-text description shown in the admin UI (e.g. "Disable
  /// to stop the AI scoring an ICP-fit per contact").
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([key])
}

// Two-level feature-toggle UX — super-admin layer.
// ────────────────────────────────────────────────────────────────
// FeatureFlag (above) is the GLOBAL kill-switch + the CLIENT-ADMIN
// opt-out layer (lib/philly/features.ts → orgFlag / globalFlag in
// the resolve() input). This table is the SUPER-ADMIN layer: rows
// here record Juan / lucenai.eu staff explicitly forcing a feature
// ON or OFF for a specific org, with mandatory `reason` text and
// `createdById` tying the action to a User for audit.
//
// Precedence (encoded in lib/philly/features/resolve.ts):
//   1. state='FORCED_OFF' beats everything (terminal off)
//   2. state='FORCED_ON' beats plan-tier check (preview features),
//      orgFlag (client opt-out), and globalFlag (global kill-switch)
//   3. state='INHERIT' is equivalent to no row — fall through to
//      plan / globalFlag / orgFlag / default
//
// `state` is a String (not a Prisma enum) for consistency with
// existing User.role / AuditLog.action conventions. Allowed values
// are enforced by lib/philly/validation/schemas.ts + the API route's
// zod schema. The TS-side enum lives at lib/philly/features/resolve.ts
// as SuperAdminOverride.
//
// `feature` matches a FEATURES.*.key value from
// lib/philly/features.ts. Compound-unique on (organizationId,
// feature) so an org can have at most one override per feature.
model OrgFeatureOverride {
  id             String   @id @default(cuid())
  organizationId String
  /// Feature key from FEATURES const (lib/philly/features.ts).
  feature        String
  /// INHERIT | FORCED_ON | FORCED_OFF — see lib/philly/features/resolve.ts.
  state          String   @default("INHERIT")
  /// Why super-admin made this change. Mandatory at the route layer
  /// (min 10 chars). Lands in AuditLog.changes for compliance.
  reason         String   @db.Text
  /// User.id of the super-admin who created the row. The user MUST
  /// have role='superAdmin' at the time of write (enforced at the
  /// route layer; not at the DB level — see PR-2b API route).
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("OrgFeatureOverrideCreator", fields: [createdById], references: [id])

  @@unique([organizationId, feature])
  @@index([feature])
  @@index([createdById])
}

// ScimGroup — IdP group surfaced via SCIM 2.0 (RFC 7643 §4.2).
// Operators set `role` / `dashboardSections` on the group via the
// admin UI (or directly in DB). When an IdP sends a member-add
// PATCH against the group, the user's Membership in that org is
// upserted to the group's role + sections — which is how
// `engineering` → manager / `marketing` → viewer mapping works
// without a custom claim parser per IdP.
//
// scimExternalId is the IdP's stable id (e.g. Okta group id).
// displayName is what the IdP sees + sends back in payloads.
//
// Bundle BW; closes the SSO-SETUP.md "Groups outstanding" gap.
model ScimGroup {
  id                String   @id @default(cuid())
  organizationId    String
  scimExternalId    String?
  displayName       String
  /// Maps to Membership.role for users added via this group.
  /// Null = no role assignment (group is just metadata + a way
  /// to track which IdP groups the user belongs to).
  role              String?
  /// Maps to Membership.dashboardSections (Json array of
  /// section ids, or null = full access). Null on the group
  /// means "don't override the user's per-org sections".
  dashboardSections Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ScimGroupMembership[]

  @@unique([organizationId, displayName])
  @@index([organizationId, scimExternalId])
}

// ScimGroupMembership — many-to-many join between User and ScimGroup.
// Cascades when either side is deleted so we don't leak orphan rows.
model ScimGroupMembership {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group ScimGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}
