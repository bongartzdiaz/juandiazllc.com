# Prisma — MariaDB connection string. The CRM uses @prisma/adapter-mariadb,
# so this should be a mysql:// URL with a mariadb-compatible server on the
# other end.
DATABASE_URL="mysql://user:password@localhost:3306/philly"

# Supabase — used for brand-side auth (session cookies, sign-up, reset,
# magic links). Get these from your Supabase project dashboard.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Sentry — optional but recommended for prod. When SENTRY_DSN is unset
# the lib/philly/sentry wrapper becomes a no-op.
SENTRY_DSN=""

# Sentry project auth for source-map upload during next build.
SENTRY_AUTH_TOKEN=""

# Google OAuth (if the email/calendar integration is used). Leave blank
# until you wire it.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Anthropic — for the AI command-bar + AI attributes. Leave blank if
# AI features are unused.
ANTHROPIC_API_KEY=""
