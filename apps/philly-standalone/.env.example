# ─────────────────────────────────────────────────────────────────────────
# Required in production — the app refuses to encrypt anything sensitive
# without these, and several routes hard-fail or fall back to dev-only
# placeholders that are NOT safe for real data.
# ─────────────────────────────────────────────────────────────────────────

# Prisma — MariaDB connection string. The CRM uses @prisma/adapter-mariadb,
# so this should be a mysql:// URL with a mariadb-compatible server on the
# other end.
DATABASE_URL="mysql://user:password@localhost:3306/philly"

# Supabase — used for auth (session cookies, sign-up, reset, magic links).
# Get these from your Supabase project dashboard.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# AES-256-GCM key for encrypting OAuth tokens, webhook secrets, TOTP
# secrets, and integration credentials at rest.  Generate with:
#   openssl rand -base64 32
# CRITICAL: in production, lib/philly/crypto.ts THROWS at import if this
# (or NEXTAUTH_SECRET as fallback) is missing.  In development it falls
# back to a deterministic placeholder — DO NOT ship without setting this.
INTEGRATION_SECRET=""

# HMAC key for signing OAuth state tokens (CSRF protection on the
# integrations OAuth flow).  Generate with:
#   openssl rand -base64 32
OAUTH_STATE_SECRET=""

# Bearer token used by Vercel Cron to call /api/cron/gdpr-retention.
# Set in Vercel project settings; the daily retention purge will
# silently no-op if this is unset.
CRON_SECRET=""

# Public canonical origin for redirects (OAuth callbacks, magic links).
APP_URL="https://your-deployment.example.com"

# ─────────────────────────────────────────────────────────────────────────
# Recommended in production — non-blocking but operationally important.
# ─────────────────────────────────────────────────────────────────────────

# Sentry — when SENTRY_DSN is unset, lib/philly/observability.ts becomes
# a no-op and SLO bucket tagging stops working.
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ENVIRONMENT="production"
SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE="0.1"

# Build-time commit SHA, surfaced in /api/health for deploy provenance.
GIT_COMMIT_SHA=""

# Structured-logger level — debug | info | warn | error.  Defaults to
# info; bump to debug for incident response, leave on info in steady-state.
LOG_LEVEL="info"

# Slack webhook used by /api/log-error to fan out client-side errors.
SLACK_ERROR_WEBHOOK_URL=""

# Slack webhook used by lib/philly/alerts.ts for server-side alerts
# (cron-job failures, schema drift, billing webhook errors). Distinct
# from SLACK_ERROR_WEBHOOK_URL so noisy client errors don't drown out
# operator alerts — point each at a separate channel.
SLACK_ALERTS_WEBHOOK=""

# Deterministic blind-index key for searchable encrypted PII columns
# (Contact.email_hash, Contact.phone_hash). MUST be distinct from
# INTEGRATION_SECRET; rotating it requires re-running
# `npm run pii:backfill-hashes`. 32+ bytes random, hex.
BLIND_INDEX_SECRET=""

# Stripe billing — required for self-service checkout. Use test keys
# in dev (sk_test_…); flip to live keys (sk_live_…) only after the
# end-to-end test-mode flow in STRIPE-SETUP.md §A-C is verified.
STRIPE_SECRET_KEY=""
# Webhook signing secret from the endpoint registered in
# Dashboard → Developers → Webhooks. Without this the
# /api/webhooks/stripe handler rejects every event as unsigned.
STRIPE_WEBHOOK_SECRET=""
# Price IDs of the three plans created in Stripe (Operator/Team/Business)
# — see lib/philly/billing/plans.ts for the plan registry. Each
# environment (test / live) has its own price IDs.
STRIPE_PRICE_OPERATOR=""
STRIPE_PRICE_TEAM=""
STRIPE_PRICE_BUSINESS=""

# Mandatory TOTP 2FA enforcement on admin role.  When true, admins
# without 2FA enrolled are blocked from admin-gated endpoints (409
# NEEDS_2FA) and admin server pages redirect them to /setup-2fa.
# Defaults: true in production, false otherwise (so dev/test
# environments don't trip before the operator has gone through the
# setup flow).  Override here to force on or off.
ADMIN_MFA_ENFORCED=""

# Audit-log retention in days — overrides the default 365.  Lowering this
# can violate Art. 30 record-keeping; check docs/legal/PRIVACY-NOTICE.md
# before changing.
AUDIT_RETENTION_DAYS="365"

# ─────────────────────────────────────────────────────────────────────────
# Optional — feature-gated.  Leave blank until you wire the integration.
# ─────────────────────────────────────────────────────────────────────────

# Anthropic — for the AI command-bar + AI attributes.  Leave blank if AI
# features are unused.
ANTHROPIC_API_KEY=""

# In-app AI assistant (separate from the AI command-bar above).  The
# assistant calls a self-hosted Ollama box that runs the chat +
# embedding models.  See docker/ollama/README.md for VPS setup.
# Leave blank to disable the assistant at /assistant.
OLLAMA_BASE_URL="https://ollama.example.com"
ASSISTANT_CHAT_MODEL="qwen2.5:14b-instruct-q4_K_M"
ASSISTANT_EMBED_MODEL="bge-m3"
# Bearer token sent as Authorization: Bearer ${OLLAMA_AUTH_TOKEN} on
# every Ollama request.  Must match the value in the Caddy gate at
# docker/ollama/Caddyfile.  Generate with: openssl rand -base64 48
# Leave blank for localhost dev where Ollama isn't gated.
OLLAMA_AUTH_TOKEN=""

# DeepL API key used by `npm run kb:translate` to translate the en/
# knowledge base into nl/de/es.  Free-tier key suffix is `:fx`; pro
# keys are bare. Get one at https://www.deepl.com/pro-api .
# Operator-only — never set on the deployed app, only on the dev
# machine that runs the translation pipeline.
DEEPL_API_KEY=""

# Set to "1" to make `npm run kb:check` exit non-zero when any en
# doc is missing a translation in nl/de/es.  Wire this to CI once
# the translation backlog is at zero.  Defaults to informational.
CHECK_KB_STRICT=""

# Path to your Obsidian vault for the two-way KB sync (npm run
# vault:sync).  Default is ./obsidian-vault inside this repo
# (gitignored).  Point at your real vault, e.g.
# /Users/marco/Documents/Philly\ Vault, when wiring up.  Operator-
# only — never set on the deployed app.
OBSIDIAN_VAULT_PATH=""

# Google OAuth (Gmail / Calendar integration).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Twilio (SMS + WhatsApp).  TWILIO_FROM is the SMS sender number;
# TWILIO_WHATSAPP_FROM is the WhatsApp sandbox or business number.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
TWILIO_WHATSAPP_FROM=""

# ─────────────────────────────────────────────────────────────────────────
# Tuning knobs — sensible defaults; only override if you know why.
# ─────────────────────────────────────────────────────────────────────────

# /api/log-error per-IP rate-limit bucket capacity (default 20).
ERROR_LOG_RATE_CAPACITY="20"

# /api/vitals per-IP rate-limit bucket capacity (default 60).
VITALS_RATE_CAPACITY="60"

# ─────────────────────────────────────────────────────────────────────────
# Legacy — present in code but slated for removal.  Set NEXTAUTH_SECRET
# only as a fallback for INTEGRATION_SECRET on existing deployments;
# new deployments should set INTEGRATION_SECRET explicitly.
# ─────────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=""
NEXTAUTH_URL=""
