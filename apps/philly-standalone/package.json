{
  "name": "philly-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Philly CRM — operator-first CRM extracted as standalone Next.js app from juandiazllc.com. Mirror maintained for disaster recovery + independent deployment.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:tenant": "tsx scripts/audit-tenant-isolation.ts",
    "audit:chain": "tsx scripts/verify-audit-chain.ts",
    "audit:dead-links": "tsx scripts/audit-dead-links.ts",
    "audit:sync-mirror": "tsx scripts/audit-sync-mirror.ts",
    "audit:sync-mirror:fast": "tsx scripts/audit-sync-mirror.ts --skip-build",
    "launch:check": "tsx scripts/check-launch-readiness.ts",
    "check:dead": "knip --no-exit-code",
    "check:dead:strict": "knip",
    "db:slow": "tsx scripts/db-slow-queries.ts",
    "i18n:fill": "tsx scripts/i18n-fill-missing.ts",
    "pii:backfill": "tsx scripts/encrypt-contact-notes.ts",
    "pii:backfill-notes": "tsx scripts/encrypt-contact-note-content.ts",
    "pii:backfill-hashes": "tsx scripts/backfill-contact-blind-index.ts",
    "pii:rotate": "tsx scripts/rotate-pii-key.ts",
    "seed:super-admins": "tsx prisma/seed-super-admins.ts",
    "grant:super-admin": "tsx scripts/grant-super-admin.ts",
    "revoke:super-admin": "tsx scripts/revoke-super-admin.ts",
    "kb:build": "tsx scripts/build-assistant-kb.ts",
    "kb:check": "tsx scripts/check-assistant-kb.ts",
    "kb:translate": "tsx scripts/translate-assistant-kb.ts",
    "vault:export": "tsx scripts/vault-sync.ts export",
    "vault:import": "tsx scripts/vault-sync.ts import",
    "vault:sync": "tsx scripts/vault-sync.ts sync",
    "vault:check": "tsx scripts/vault-sync.ts check",
    "test:integration": "bash scripts/test-integration.sh",
    "test:integration:down": "docker compose -f docker/test-db/docker-compose.yml down -v",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@prisma/adapter-mariadb": "^7.7.0",
    "@prisma/client": "^7.5.0",
    "@sentry/node": "^9.47.1",
    "@sentry/react": "^9.47.1",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.45.4",
    "ai": "^6.0.168",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.1",
    "lucide-react": "^0.577.0",
    "next": "^16.2.4",
    "next-intl": "^4.11.0",
    "otplib": "^13.4.0",
    "prisma": "^7.5.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "stripe": "^22.1.1",
    "swr": "^2.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@swc/helpers": "^0.5.21",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "knip": "^6.11.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "//overrides": "Bundle CN — pin transitive deps with moderate-severity advisories so the security CI workflow stays clean. postcss <8.5.10 GHSA-qx2v-qp2m-jg93; @hono/node-server <1.19.13 GHSA-92pp-h63x-v22m. Both reach via Next + @prisma/dev; both ship in build/dev tooling only but the audit gate doesn't distinguish.",
  "overrides": {
    "postcss": "^8.5.10",
    "@hono/node-server": "^1.19.13"
  }
}
