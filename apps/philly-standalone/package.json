{
  "name": "philly-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Philly CRM — operator-first CRM extracted as standalone Next.js app from juandiazllc.com. Mirror maintained for disaster recovery + independent deployment.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:tenant": "tsx scripts/audit-tenant-isolation.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-mariadb": "^7.7.0",
    "@prisma/client": "^7.5.0",
    "@sentry/node": "^9.47.1",
    "@sentry/react": "^9.47.1",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.45.4",
    "@types/bcryptjs": "^2.4.6",
    "ai": "^6.0.168",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.1",
    "lucide-react": "^0.577.0",
    "mariadb": "^3.5.2",
    "next": "^16.2.4",
    "otplib": "^13.4.0",
    "prisma": "^7.5.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-is": "^19.2.5",
    "recharts": "^3.8.1",
    "swr": "^2.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
