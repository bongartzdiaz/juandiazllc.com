{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/page.tsx",
    "app/**/layout.tsx",
    "app/**/route.ts",
    "app/**/error.tsx",
    "app/**/not-found.tsx",
    "app/global-error.tsx",
    "i18n/request.ts",
    "prisma/seed.ts",
    "scripts/**/*.ts",
    "**/*.test.ts"
  ],
  "project": [
    "**/*.{js,ts,tsx}",
    "!coverage/**"
  ],
  "ignore": [
    "vitest.integration.config.ts"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "postcss"
  ],
  "rules": {
    "files": "error",
    "binaries": "error",
    "dependencies": "warn",
    "devDependencies": "warn",
    "optionalPeerDependencies": "warn",
    "unlisted": "warn",
    "unresolved": "warn",
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "enumMembers": "warn",
    "classMembers": "warn",
    "duplicates": "warn"
  }
}
