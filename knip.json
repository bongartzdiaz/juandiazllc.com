{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/page.tsx",
    "app/**/layout.tsx",
    "app/**/route.ts",
    "app/**/error.tsx",
    "app/**/not-found.tsx",
    "app/global-error.tsx",
    "app/philly/global-error.tsx",
    "i18n/**/request.ts",
    "tests/**/*.{spec,test}.{js,ts,tsx}",
    "**/*.test.{ts,tsx}"
  ],
  "project": [
    "**/*.{js,ts,tsx}",
    "!apps/**",
    "!coverage/**",
    "!playwright-report/**"
  ],
  "ignore": [
    "components/sections/Testimonials.tsx",
    "public/**"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "postcss"
  ],
  "ignoreBinaries": [
    "sentry-cli"
  ],
  "rules": {
    "files": "error",
    "binaries": "error",
    "dependencies": "warn",
    "devDependencies": "warn",
    "optionalPeerDependencies": "warn",
    "unlisted": "warn",
    "unresolved": "warn",
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "enumMembers": "warn",
    "classMembers": "warn",
    "duplicates": "warn"
  }
}
