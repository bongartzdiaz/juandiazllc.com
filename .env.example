# ──────────────────────────────────────────────────────────────────
# DEUS / LucenAI environment variables
# ──────────────────────────────────────────────────────────────────
# Copy to .env.local for development. Production vars live in Vercel
# / Hetzner. See _drafts/operator/env-vars-walkthrough.md for the
# operator setup walkthrough.

# ── Site identity ──
NEXT_PUBLIC_SITE_URL=https://juandiazllc.com
# Used by calendar push-sync subscribe + Stripe Checkout return URLs.
# Must be set for OAuth callbacks to work in production.
NEXT_PUBLIC_APP_URL=https://juandiazllc.com

# ── Supabase (auth + brand-site CMS) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Preferred — the new revocable key pair. Rotating these does NOT sign
# users out; rotating a legacy JWT key requires rotating the project's
# JWT secret, which does.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Legacy fallback — still read if the two above are unset, so a
# deployment can migrate without downtime. Remove once the new keys
# are live everywhere.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Database (Prisma — DEUS CRM data) ──
DATABASE_URL=mysql://user:pass@host:3306/deus

# ── NextAuth (legacy — being migrated to Lucia mid-week-1) ──
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=https://juandiazllc.com

# ── Calendar OAuth — Google ──
# GCP Console → APIs & Services → Credentials → OAuth 2.0 client.
# Authorized redirect URI: $NEXT_PUBLIC_APP_URL/philly/api/calendar/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Calendar OAuth — Microsoft 365 / Entra ID ──
# Entra → App registrations → New registration → Calendars.Read + offline_access scopes.
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
# Tenant ID (use 'common' for multi-tenant + personal MSA accounts).
MS_OAUTH_TENANT=common

# ── HMAC secret for OAuth state CSRF token ──
# Generate fresh: openssl rand -base64 32
OAUTH_STATE_SECRET=

# ── Calendar push-sync retention ──
# Days before expired/error CalendarChannel rows are hard-pruned.
# Default 90, floor 30.
CALENDAR_CHANNEL_PRUNE_DAYS=90

# ── Cron auth ──
# Same secret for /api/audit/prune + /api/calendar/cron/renew-channels +
# /api/calendar/cron/prune-channels. Send as `X-Cron-Secret: $CRON_SECRET`.
CRON_SECRET=

# ── Audit log retention ──
AUDIT_RETENTION_DAYS=365

# ── Stripe billing ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PROFESSIONAL=price_xxx

# ── Email (Resend) ──
RESEND_API_KEY=re_xxx
INVITE_FROM_EMAIL=invites@lucen.ai

# ── Telegram lead-notificaties (marketing-site contactformulier) ──
# Token via @BotFather (/newbot). Chat-id: stuur je bot een bericht en
# lees het id uit https://api.telegram.org/bot<TOKEN>/getUpdates
# (message.chat.id). Beide leeg = stille no-op, lead landt altijd in
# Supabase `leads`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── SMS (Twilio) — optional, for SMS flows ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=

# ── AI (Anthropic) — optional, for AI-insight features ──
ANTHROPIC_API_KEY=

# ── Web enrichment (Firecrawl) — optional, for AI contact attributes ──
# When set, AI-attribute enrichment also reads the public homepage of a
# contact's email domain (consumer mailboxes like gmail.com are skipped).
# LEAVING THIS UNSET IS THE PRIVACY-SAFE DEFAULT: enrichment then uses
# only data already on the CRM row. Before enabling in production, read
# docs/legal/DPIA-AI-ATTRIBUTES.md — it changes the lawful-basis
# analysis and adds Firecrawl as a sub-processor you must disclose.
FIRECRAWL_API_KEY=

# ── SEO-data (DataForSEO) — optional, voor de pulse en scripts/seo-report.ts ──
# Gelezen door lib/seo/dataforseo.ts en scripts/seo-report.ts. Beide leeg =
# `npm run seo:report` weigert te draaien; `npm run seo:report:dry` toont dan
# nog steeds gratis wat er opgevraagd zou worden.
#
# Halen bij https://app.dataforseo.com/api-access — dat is NIET je
# accountwachtwoord maar een apart, gegenereerd API-wachtwoord.
#
# LET OP DE TWEE VORMEN. Deze twee variabelen zijn de losse waarden. OpenSEO
# (route 3 in MANUAL_TASKS.md) wil dezelfde inloggegevens als één
# `DATAFORSEO_API_KEY`: de base64 van `email:wachtwoord`, in het
# DataForSEO-dashboard te kopiëren als "Base64"-credentials. Eén account, twee
# vormen — verwissel ze niet.
#
# Elk verzoek kost geld. De client geeft `cost` per antwoord terug en het
# rapport telt op; laat dat staan.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Observability (Sentry) — optional but recommended ──
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Misc ──
# Optional — Cal.com booking link (leave blank to fall back to mailto)
NEXT_PUBLIC_CAL_URL=
# Per-row HMAC for legacy integration tokens (rotate quarterly).
INTEGRATION_SECRET=
LOG_LEVEL=info
