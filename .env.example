# ─────────────────────────────────────────────────────────────────
# juandiazllc.com root env.example
#
# This is the parent monorepo's env.example, NOT to be confused with
# apps/philly-standalone/.env.example which is the partner-deploy
# mirror's own env spec. They overlap on most secrets (Supabase,
# Stripe, Sentry, Twilio) but each has root-specific vars too —
# this file covers the marketing site + /philly admin routes hosted
# at juandiazllc.com.
#
# Drift check: `npm run check:env-drift` scans source for
# `process.env.X` references and fails if X isn't declared here.
# After adding a new env-var read in code, mirror the addition here
# with a 1-3 line comment explaining purpose, defaults, when it
# matters.
#
# All values below are placeholders. Real values live in your vault +
# Vercel project env. NEVER commit a real secret here.
# ─────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Service-role key — bypasses RLS. Server-only, never expose to
# client code. Used by admin routes + scheduled jobs.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Site URLs ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://juandiazllc.com
# Operator-facing deployment URL (often same as site URL; can differ
# for staging / preview deploys).
APP_URL=https://juandiazllc.com

# Optional — Cal.com booking link (leave blank to fall back to mailto)
NEXT_PUBLIC_CAL_URL=

# Optional — Google Search Console verification token. When set,
# rendered in <head> as a meta tag on the marketing pages.
GOOGLE_SITE_VERIFICATION=

# ── Database ─────────────────────────────────────────────────────
# Prisma datasource URL. Format depends on provider:
#   - PostgreSQL: postgresql://user:pass@host:5432/db
#   - MySQL/MariaDB: mysql://user:pass@host:3306/db
DATABASE_URL=""

# ── Auth (NextAuth + Supabase Auth hybrid) ───────────────────────
# NextAuth shared secret — required, 32+ bytes random.
NEXTAUTH_SECRET=""
# Canonical URL for NextAuth callbacks. Vercel sets this automatically
# from VERCEL_URL when unset; override only for non-Vercel hosts.
NEXTAUTH_URL=""
# HMAC-strength secret for OAuth state parameter (CSRF defense on
# OAuth callbacks).
OAUTH_STATE_SECRET=""

# ── Cron / scheduled jobs ────────────────────────────────────────
# Bearer token for /api/cron/* endpoints. Vercel Cron sets this in
# the Authorization header on scheduled invocations.
CRON_SECRET=""
# Override audit log retention (days). Defaults to 365.
AUDIT_RETENTION_DAYS=""

# ── Stripe billing ───────────────────────────────────────────────
# Stripe secret key. sk_test_ for dev/staging, sk_live_ for prod.
# Walk apps/philly-standalone/docs/operations/STRIPE-SETUP.md to
# stand up live mode end-to-end.
STRIPE_SECRET_KEY=""
# Webhook signing secret from Stripe Dashboard → Developers →
# Webhooks → your endpoint. Without it /api/webhooks/stripe rejects
# every event as unsigned.
STRIPE_WEBHOOK_SECRET=""

# ── Sentry (server-side) ─────────────────────────────────────────
# Server DSN. When unset, lib/philly/observability becomes a no-op
# and SLO bucket tagging stops working.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE="0.1"

# ── Sentry (browser) ─────────────────────────────────────────────
# Separate DSN allowed (often the same DSN). Read by Sentry's browser
# SDK. Replay sample rates default to 0 (no session replay) if unset.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
NEXT_PUBLIC_SENTRY_RELEASE=""
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE="0"
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE="0"

# ── Slack webhooks ───────────────────────────────────────────────
# Operator alerts (cron failures, schema drift, billing webhook errors).
SLACK_ALERTS_WEBHOOK=""
# Client-side error fan-out via /api/log-error. Point at a separate
# channel from SLACK_ALERTS_WEBHOOK so client noise doesn't drown
# out operator alerts.
SLACK_ERROR_WEBHOOK_URL=""

# ── Email ────────────────────────────────────────────────────────
# Resend API key — used for transactional email (signup confirm,
# password reset, newsletter).
RESEND_API_KEY=""
# Sender address for inbound contact-form notifications. Must be a
# verified Resend domain.
CONTACT_NOTIFY_FROM=""
# Comma-separated recipient list for contact-form notifications.
CONTACT_NOTIFY_TO=""
# Sender address for outbound newsletter blasts.
NEWSLETTER_FROM=""

# ── Twilio (SMS / WhatsApp) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Sender phone in E.164 format (e.g., +15551234567).
TWILIO_FROM=""
# WhatsApp Business sender (separate from SMS, prefix `whatsapp:` then
# the E.164 number).
TWILIO_WHATSAPP_FROM=""

# ── Google OAuth ─────────────────────────────────────────────────
# OAuth client credentials for Gmail integration + Google Calendar.
# Create at https://console.cloud.google.com/apis/credentials .
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── AI / Anthropic ───────────────────────────────────────────────
# Anthropic API key for the AI command bar + scoring + insights.
# Required for /philly/ai routes; if unset, AI endpoints 503.
ANTHROPIC_API_KEY=""

# ── Analytics (Plausible — privacy-friendly, no cookies) ─────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
# Override the Plausible host (self-hosted instances). Defaults to
# plausible.io when unset.
NEXT_PUBLIC_PLAUSIBLE_HOST=""

# ── Logging + rate limits ────────────────────────────────────────
# Structured-logger level — debug | info | warn | error. Defaults to
# info; bump to debug for incident response.
LOG_LEVEL=""
# Token bucket capacity for /api/log-error (client error reports).
# Defaults to a sane value if unset.
ERROR_LOG_RATE_CAPACITY=""
# Token bucket capacity for /api/vitals (Core Web Vitals beacons).
VITALS_RATE_CAPACITY=""
