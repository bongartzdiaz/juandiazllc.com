# ── Philly Dashboard — Environment Variables ──

# Database (MariaDB / MySQL via Prisma + @prisma/adapter-mariadb)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://phily:changeme@localhost:3306/phily"

# NextAuth (v4) — required in production
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3100"

# Seed defaults — used by `npm run seed` to create the first admin user
# Change these BEFORE running seed in any non-local environment
SEED_ADMIN_EMAIL="admin@philly.local"
SEED_ADMIN_PASSWORD="changeme123"
