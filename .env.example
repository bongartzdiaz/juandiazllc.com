# ───────────────────────────────────────────────────────────────
# Philly Dashboard — Environment Variables
# Copy to .env.local for dev, or set in your deployment platform.
# Run `npm run preflight` to verify your env is complete.
# ───────────────────────────────────────────────────────────────

# ── REQUIRED ───────────────────────────────────────────────────

# Database (MariaDB / MySQL via Prisma + @prisma/adapter-mariadb)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://phily:changeme@localhost:3306/phily"

# NextAuth (v4) — required in production
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"

# Public URL of the deployment (used for OAuth callbacks + email links)
NEXTAUTH_URL="http://localhost:3100"

# ── SEED DEFAULTS (only used by `npm run seed`) ────────────────
# Change these BEFORE running seed in any non-local environment
SEED_ADMIN_EMAIL="admin@philly.local"
SEED_ADMIN_PASSWORD="changeme123"

# ── OPTIONAL: AI FEATURES ──────────────────────────────────────
# The /ai insights + /ai/ask pages work without any key (rule-based).
# Set one of these to enable LLM-augmented narratives + richer answers.
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# ── OPTIONAL: EMAIL PROVIDER ───────────────────────────────────
# Used by /email send and outbound notifications.
# Leave unset to disable outbound email (UI still works, but "send" is a no-op).
# EMAIL_PROVIDER="sendgrid"          # sendgrid | postmark | resend
# EMAIL_API_KEY=""
# EMAIL_FROM="no-reply@example.com"

# ── OPTIONAL: SMS / WHATSAPP PROVIDER ──────────────────────────
# Used by /sms send and DM Champ-style outbound.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

# ── OPTIONAL: OAUTH INTEGRATIONS ───────────────────────────────
# Fill in per provider you want to connect from /integrations.
# Each one is independent — only set what you use.

# Google (Calendar + Gmail)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Microsoft (Outlook + M365)
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
# MICROSOFT_TENANT_ID="common"

# Slack
# SLACK_CLIENT_ID=""
# SLACK_CLIENT_SECRET=""

# Stripe
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Mailchimp
# MAILCHIMP_CLIENT_ID=""
# MAILCHIMP_CLIENT_SECRET=""

# QuickBooks
# QUICKBOOKS_CLIENT_ID=""
# QUICKBOOKS_CLIENT_SECRET=""

# ── OPTIONAL: FILE UPLOADS ─────────────────────────────────────
# If unset, /documents uses URL-based links (user pastes a URL).
# Set these to enable direct file upload to S3 or compatible.
# S3_ENDPOINT=""                      # e.g. https://s3.amazonaws.com (omit for AWS)
# S3_REGION="us-east-1"
# S3_BUCKET=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# ── OPTIONAL: REAL ESTATE FEEDS ────────────────────────────────
# MLS_FEED_URL=""
# MLS_FEED_API_KEY=""

# ── OPTIONAL: ERROR REPORTING ──────────────────────────────────
# Copy the DSN from Sentry → Project Settings → Client Keys.
# Leave unset to disable (captureException/Message become no-ops).
# SENTRY_DSN=""
# SENTRY_ENVIRONMENT="production"     # defaults to NODE_ENV
# SENTRY_RELEASE=""                   # usually set by CI to the git sha
# SENTRY_TRACES_SAMPLE_RATE="0"       # 0..1, sample of transactions

# ── OPTIONAL: APP TUNING ───────────────────────────────────────
# NODE_ENV="production"
# PORT=3100
# LOG_LEVEL="info"                    # debug | info | warn | error
