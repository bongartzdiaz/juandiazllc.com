# ── HMBops Dashboard — Environment Variables ──

# API base URL (eigen backend)
NEXT_PUBLIC_API_URL=/api

# ── Meta Ads ──
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_SECRET=

# ── Google Ads ──
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=

# ── DM Champ (Chatbot / WhatsApp) ──
DMCHAMP_API_KEY=
DMCHAMP_BASE_URL=https://api.dmchamp.nl/v1

# ── GoHighLevel (Sales CRM) ──
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_PIPELINE_NAME=Sales
GHL_CUSTOM_FIELD_NAME=
GHL_BASE_URL=https://services.leadconnectorhq.com

# ── Supabase (optioneel — voor caching / eigen data) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Standaard markt filter ──
NEXT_PUBLIC_DEFAULT_MARKET=NL
