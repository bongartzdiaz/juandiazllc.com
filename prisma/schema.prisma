generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  industry  String   @default("general")
  // Default seat allowance for free / trial orgs. A Subscription overrides
  // this when present (Subscription.seatCount is authoritative). Keeping a
  // column on Organization gives us a sane fallback before billing is wired.
  seatLimit Int      @default(3)
  // Soft-delete support (GDPR right to erasure). When set, the org is
  // hidden from auth/login flows; hard-purge runs 30 days later.
  deletedAt DateTime?
  // First-time-setup wizard state. Cursor advances welcome → org → team →
  // contacts → calendar → done. `skipped` is a terminal-ish state for an
  // admin who clicked "Skip" on a step that wasn't required (the banner on
  // the dashboard nudges them back).
  onboardingStep        String   @default("welcome")
  onboardingCompletedAt DateTime?
  onboardingSkippedAt   DateTime?
  // Captured during onboarding step 2; canonical at the org level. Replaces
  // the localStorage-only `pai-industry` for newly-onboarded orgs.
  timeZone        String @default("Europe/Amsterdam")
  defaultCurrency String @default("EUR") // ISO 4217
  // Privacy-by-design toggle — when true, synced calendar event titles
  // and locations are stored as a SHA-256 hash + "(redacted)" label
  // instead of verbatim. Defensive default for medical / legal /
  // financial verticals where Art. 9 special categories are likely
  // to appear in user calendars.
  redactSyncedTitles Boolean @default(false)
  createdAt DateTime @default(now())

  users          User[]
  subscription   Subscription?
  invites        Invite[]
  projects       Project[]
  contacts       Contact[]
  kanbanBoards   KanbanBoard[]
  customPages    CustomPage[]
  auditLogs      AuditLog[]
  savedViews     SavedView[]
  pipelines      Pipeline[]
  calendarEvents      CalendarEvent[]
  calendarConnections CalendarConnection[]
  notifications  Notification[]
  automations    AutomationRule[]
  webhooks       Webhook[]
  apiKeys        ApiKey[]
  templates      Template[]
  documents      Document[]
  properties     Property[]
  rooms          Room[]
  grants         Grant[]
  donorProfiles  DonorProfile[]
  volunteers     Volunteer[]
  mlsFeeds       MlsFeed[]
  listingAlerts  ListingAlert[]
  conversations  Conversation[]
  leadScores       LeadScore[]
  scoringRules     ScoringRule[]
  leadRoutingRules LeadRoutingRule[]
  callLogs         CallLog[]
  dialerLists      DialerList[]
  actionPlans      ActionPlan[]
  transactions     Transaction[]
  referrals          Referral[]
  soiCategories      SoiCategory[]
  cmaReports         CmaReport[]
  clientPortalAccess ClientPortalAccess[]
  emailAccounts      EmailAccount[]
  smsMessages        SmsMessage[]
  integrations       Integration[]
  propertyTaxonomy   PropertyTaxonomy?
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  name           String
  passwordHash   String
  role           String    @default("viewer") // admin, manager, viewer
  locale         String    @default("en")
  avatarUrl      String?
  image          String?
  organizationId String
  createdAt      DateTime  @default(now())
  // Security: brute-force lockout
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  // Security: global session invalidation — any JWT issued before this
  // timestamp is rejected. Bump this to log the user out on all devices.
  tokensInvalidAfter DateTime?
  // TOTP two-factor auth
  twoFactorSecret     String?   // encrypted via src/lib/crypto.ts
  twoFactorEnabled    Boolean   @default(false)
  twoFactorVerifiedAt DateTime?
  // GDPR Art. 17 — soft-delete window. While set, the user cannot
  // authenticate; sessions are invalidated server-side via
  // tokensInvalidAfter. Hard-purge runs 30 days after deletedAt.
  deletedAt           DateTime?
  // Who initiated the delete: self (= same id) or an org admin.
  deletedByUserId     String?

  organization    Organization     @relation(fields: [organizationId], references: [id])
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  dashboardLayout DashboardLayout?
  kanbanCards     KanbanCard[]     @relation("assignee")
  customPages     CustomPage[]
  accounts        Account[]
  sessions        Session[]
  auditLogs       AuditLog[]
  contactNotes    ContactNote[]
  activities      Activity[]
  savedViews      SavedView[]
  notifications   Notification[]
  automationLogs  AutomationLog[]
  eventAttendees  EventAttendee[]
  reports         Report[]
  deals           Deal[]          @relation("dealOwner")
  calendarConnections CalendarConnection[]

  @@index([organizationId])
}

// One Subscription per Organization. Mirrors Stripe state — the source of
// truth for billing is Stripe, this row is the cached projection we read
// on every seat-check. Created either by Stripe webhook (`subscription.created`)
// or, for trials, by an admin invite at signup time.
model Subscription {
  id                String   @id @default(cuid())
  organizationId    String   @unique
  plan              String   // "trial" | "starter" | "professional" | "enterprise"
  status            String   // "active" | "trialing" | "past_due" | "canceled"
  seatCount         Int      // billable seats — must be >= active user count
  stripeCustomerId  String?
  stripeSubId       String?  @unique
  currentPeriodEnd  DateTime?
  cancelAt          DateTime? // 30-day notice period
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Pending team-invite. Single-use token; expires at expiresAt. Marked
// acceptedAt when the invitee completes signup — at that point a User row
// is created in the same Organization with the role from this Invite.
// We keep accepted/revoked rows for the audit trail; cleanup is by
// retention policy, not by this table.
model Invite {
  id               String    @id @default(cuid())
  organizationId   String
  email            String
  role             String    // "admin" | "manager" | "viewer"
  // Cryptographically random token (32 bytes, base64url). Unique across
  // the table — collision-resistant by construction.
  token            String    @unique
  invitedByUserId  String    // FK-less reference to User.id (no cascade to keep audit row alive)
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  revokedByUserId  String?
  createdAt        DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
  @@index([organizationId, email, acceptedAt, revokedAt])
  @@index([email])
}

model TwoFactorRecoveryCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String                      // bcrypt hash of the one-time code
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── NextAuth tables (PrismaAdapter compatible) ──

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id             String    @id @default(cuid())
  title          String
  description    String    @default("") @db.Text
  status         String    @default("planned") // planned, active, completed, paused
  category       String    @default("general")
  startDate      DateTime
  endDate        DateTime?
  budgetCents    Int       @default(0)
  spentCents     Int       @default(0)
  sdgGoals       Json      @default("[]") // SDG numbers 1-17 as JSON array (MySQL has no native int[])
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id])
  milestones      ProjectMilestone[]
  impactMetrics   ImpactMetric[]
  contactProjects ContactProject[]
  kanbanCards     KanbanCard[]
  deals           Deal[]

  @@index([organizationId])
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  dueDate     DateTime
  completedAt DateTime?
  status      String    @default("pending") // pending, completed, overdue

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Contact {
  id             String   @id @default(cuid())
  name           String
  email          String   @default("")
  phone          String   @default("")
  type           String   @default("stakeholder") // partner, beneficiary, stakeholder, donor, buyer, seller, tenant, landlord
  company        String   @default("")
  notes          String   @default("") @db.Text
  avatarUrl      String?
  organizationId String
  createdAt      DateTime @default(now())

  // RE Lead fields
  leadScore       Int      @default(0)    // 0-100 behavioral score
  leadSource      String   @default("")   // website, zillow, realtor_com, referral, open_house, facebook, google, cold_call, sphere
  leadStatus      String   @default("new") // new, contacted, qualified, nurture, hot, under_contract, closed, lost
  preferredMethod String   @default("email") // email, phone, text, whatsapp
  preApproved     Boolean  @default(false)
  preApprovalAmt  Int      @default(0)    // cents
  buyerPriceMin   Int?     // cents
  buyerPriceMax   Int?     // cents
  buyerBeds       Int?
  buyerBaths      Int?
  buyerAreas      String   @default("") // comma-separated zip codes or neighborhoods
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  assignedToId    String?

  // AI-derived attributes (Attio-style) — filled by lib/philly/ai/contact-attributes
  // on contact create and on-demand refresh via /api/contacts/[id]/ai-attributes.
  // Deterministic scoring still lives in LeadScore; these are LLM-inferred.
  aiIndustry             String?   // e.g. "Residential solar", "SaaS — devtools"
  aiIcpFit               Int?      // 0-100 match against ideal customer profile
  aiSummary              String?   @db.Text // one-paragraph narrative summary
  aiAttributesStatus     String?   // "pending" | "ready" | "error" (null = never run)
  aiAttributesUpdatedAt  DateTime?
  aiAttributesError      String?   @db.Text // last error message if status=error

  organization    Organization     @relation(fields: [organizationId], references: [id])
  contactProjects ContactProject[]
  contactNotes    ContactNote[]
  activities      Activity[]
  deals           Deal[]
  offers          Offer[]
  openHouseVisits OpenHouseVisit[]

  @@index([organizationId, createdAt])
  @@index([organizationId, leadScore])
  @@index([organizationId, leadStatus])
  @@index([assignedToId])
}

model ContactProject {
  id        String @id @default(cuid())
  contactId String
  projectId String
  role      String @default("member")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([contactId, projectId])
}

model ImpactMetric {
  id         String   @id @default(cuid())
  projectId  String
  metricType String // co2_kg, people_helped, trees_planted, money_donated, water_liters, energy_kwh, custom
  value      Float
  unit       String   @default("")
  date       DateTime @default(now())
  notes      String   @default("") @db.Text

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model KanbanBoard {
  id             String   @id @default(cuid())
  title          String
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id])
  columns      KanbanColumn[]

  @@index([organizationId])
}

model KanbanColumn {
  id       String @id @default(cuid())
  boardId  String
  title    String
  position Int
  color    String @default("#94A3B8")

  board KanbanBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards KanbanCard[]

  @@index([boardId])
}

model KanbanCard {
  id          String    @id @default(cuid())
  columnId    String
  projectId   String?
  title       String
  description String    @default("") @db.Text
  position    Int
  priority    String    @default("medium") // low, medium, high, urgent
  dueDate     DateTime?
  assigneeId  String?

  column   KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  project  Project?     @relation(fields: [projectId], references: [id])
  assignee User?        @relation("assignee", fields: [assigneeId], references: [id])

  @@index([columnId])
  @@index([projectId])
  @@index([assigneeId])
}

model DashboardLayout {
  id          String   @id @default(cuid())
  userId      String   @unique
  widgetsJson String   @default("[]") @db.LongText // JSON string of DashboardWidget[]
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomPage {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  slug           String
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  creator      User         @relation(fields: [createdBy], references: [id])
  blocks       PageBlock[]

  @@unique([organizationId, slug])
  @@index([createdBy])
}

model PageBlock {
  id       String @id @default(cuid())
  pageId   String
  type     String // text, table, chart, embed, kanban, image
  content  String @default("{}") @db.LongText // JSON content
  position Int

  page CustomPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

// ── Phase 1: Audit & Data Integrity ──

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  action         String   // create, update, delete
  entity         String   // project, contact, kanbanCard, etc.
  entityId       String?
  changes        String   @default("{}") @db.LongText // JSON diff {field: {old, new}}
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
}

// ── Phase 2A: Contact 360 ──

model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([contactId, createdAt])
  @@index([userId])
}

model Activity {
  id             String   @id @default(cuid())
  organizationId String?
  contactId      String?
  userId         String?
  type           String   // note, email, call, meeting, task, deal_update, status_change
  title          String
  description    String   @default("") @db.Text
  metadata       String   @default("{}") @db.LongText // JSON extra data
  createdAt      DateTime @default(now())

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id])

  @@index([contactId, createdAt])
  @@index([userId, createdAt])
}

// ── Phase 2B: Saved Views ──

model SavedView {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  entity         String   // contacts, projects, deals
  name           String
  filtersJson    String   @default("[]") @db.LongText  // JSON filter rules
  columnsJson    String   @default("[]") @db.LongText  // visible columns
  sortJson       String   @default("{}") @db.LongText  // sort config
  isDefault      Boolean  @default(false)
  isShared       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, entity])
}

// ── Phase 2C: Pipeline & Deals ──

model Pipeline {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  industry       String   @default("general") // philanthropy, realestate, hospitality
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id])
  stages       PipelineStage[]
  deals        Deal[]

  @@index([organizationId])
}

model PipelineStage {
  id         String @id @default(cuid())
  pipelineId String
  name       String
  position   Int
  color      String @default("#94A3B8")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId])
}

model Deal {
  id          String    @id @default(cuid())
  pipelineId  String
  stageId     String
  contactId   String?
  projectId   String?
  propertyId  String?
  ownerId     String?
  title       String
  valueCents  Int       @default(0)
  currency    String    @default("USD")
  probability Int       @default(50) // 0-100
  status      String    @default("open") // open, won, lost
  dealType    String    @default("buy") // buy, sell, rent, lease, dual
  expectedClose DateTime?
  actualClose   DateTime?
  notes       String    @default("") @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Commission tracking
  commissionPct     Float  @default(3.0)   // agent commission %
  commissionCents   Int    @default(0)     // calculated commission
  brokerSplitPct    Float  @default(30.0)  // brokerage split %
  teamSplitPct      Float  @default(0)     // team lead split %
  referralFeePct    Float  @default(0)     // referral fee %
  netCommissionCents Int   @default(0)     // after all splits
  earnestMoneyCents Int    @default(0)

  // Transaction management
  inspectionDate     DateTime?
  appraisalDate      DateTime?
  titleDate          DateTime?
  finalWalkDate      DateTime?
  closingDate        DateTime?
  contingenciesJson  String  @default("[]") @db.LongText // JSON array of {name, status, dueDate}
  closingChecklistJson String @default("[]") @db.LongText // JSON array of {task, done, dueDate}

  // Source tracking
  leadSource  String @default("")

  pipeline Pipeline      @relation(fields: [pipelineId], references: [id])
  stage    PipelineStage @relation(fields: [stageId], references: [id])
  contact  Contact?      @relation(fields: [contactId], references: [id])
  project  Project?      @relation(fields: [projectId], references: [id])
  property Property?     @relation(fields: [propertyId], references: [id])
  owner    User?         @relation("dealOwner", fields: [ownerId], references: [id])
  offers   Offer[]

  @@index([pipelineId, stageId])
  @@index([contactId])
  @@index([propertyId])
  @@index([status])
}

// ── Phase 2D: Calendar Events ──

// Per-user OAuth connection to a third-party calendar provider. Tokens
// are encrypted at rest via lib/philly/crypto.ts (AES-256-GCM with key
// derived from INTEGRATION_SECRET / NEXTAUTH_SECRET). Each user can
// connect at most one calendar per provider — enforced via the
// `(userId, provider)` unique index.
//
// Lifecycle:
//   1. User clicks Connect in /onboarding/calendar or /settings.
//   2. /api/calendar/oauth/start signs a state token containing
//      { userId, orgId, provider, redirectTo, nonce, expiresAt } and
//      redirects to the provider's authorize endpoint.
//   3. Provider redirects back to /api/calendar/oauth/callback with
//      ?code=... &state=... — we verify state, exchange code for
//      tokens, encrypt + persist a CalendarConnection.
//   4. Token refresh happens lazily on read (see lib/philly/calendar/
//      connection.ts → ensureFreshAccessToken). expiresAt < now+30s ⇒
//      we exchange the refreshToken before returning the access token.
//
// Soft-disconnect: status='revoked' instead of row delete, so we keep
// an audit trail for compliance reviews. Hard-delete only on user
// account erasure (DSAR Art. 17), via the existing User cascade.
model CalendarConnection {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  provider       String    // "google" | "microsoft"
  // Provider-side identity — Google `email`, Microsoft `userPrincipalName`.
  // Used to display "Connected as foo@example.com" in the UI without
  // having to call the provider again.
  providerAccountId String
  providerEmail     String?
  // Encrypted via encryptSecret() — never logged, never returned over
  // the wire. Decryption is server-only via decryptSecret().
  accessTokenEnc String   @db.Text
  refreshTokenEnc String? @db.Text
  // When the access token expires. We refresh proactively at 30s
  // before this timestamp on read. Null means the provider didn't
  // include `expires_in` (rare; we'll refresh on first 401).
  expiresAt      DateTime?
  // Space-separated scope string from the token response. Stored so
  // we know whether to ask for re-consent when we add features that
  // need wider scopes.
  scopes         String    @db.Text
  status         String    @default("active") // active, revoked, error
  // Last error from a token refresh or API call — null on success.
  // Used to surface "Reconnect" prompts in the UI without polluting
  // the audit log with transient failures.
  lastError      String?   @db.Text
  // Throttled — updated on every successful API call, used to age
  // out unused connections on a janitor job.
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Organization deletion is intentionally NOT cascaded. Calendar
  // connections belong to a User; an org delete that orphans
  // connections is almost always a mistake. We let the FK constraint
  // refuse the delete (Prisma default = Restrict) so the operator has
  // to explicitly clear or move the connections first. User-side
  // cascade above handles the GDPR Art. 17 erasure path.
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  channels       CalendarChannel[]
  syncedEvents   SyncedCalendarEvent[]

  @@unique([userId, provider])
  @@index([organizationId, provider])
  @@index([status])
}

// Per-CalendarConnection push-sync registration with the provider.
// Google calls these "channels", Microsoft calls them "subscriptions" —
// we use a single neutral term. Lives separately from CalendarConnection
// so OAuth state and push-sync state have independent lifecycles
// (a channel can fail without invalidating the OAuth tokens, and vice
// versa). See docs/calendar-push-sync.md for the architectural rationale.
//
// Idempotency: providers can deliver the same notification twice. We
// dedupe at two layers — `lastMessageNum` (Google's monotonic counter)
// and the upstream upsert that the actual event sync uses. Even if a
// notification fires the sync twice, the DB state is the same.
//
// Renewal: Google channels live 7 days, Microsoft subscriptions ~70
// hours. A cron job (TODO) finds rows where expiresAt < NOW + buffer
// and renews them — Google by creating a new channel + stopping the
// old one, Microsoft by PATCH /subscriptions/{id}.
model CalendarChannel {
  id             String    @id @default(cuid())
  connectionId   String
  provider       String    // mirrors connection.provider — denormalized for index
  // Google: channel id we generated and sent in `watch`. MS: subscriptionId
  // returned by /subscriptions. Unique per provider — used by webhook to
  // look up which connection owns this notification.
  externalId     String
  // Google only — opaque resource id returned by `watch`. Required to call
  // /channels/stop. Null on MS (DELETE /subscriptions/{id} uses externalId).
  resourceId     String?
  // MS only — the subscribed resource path (e.g. "me/events"). Stored so
  // an auditor can see what was watched without joining tables.
  resource       String?
  // Encrypted via lib/philly/crypto.ts — Google's `token` (echoed back as
  // X-Goog-Channel-Token) and MS's `clientState` (echoed in every
  // notification body). Generated as 32-byte base64url random at create
  // time. Verified on every webhook delivery before we trust the payload.
  authSecretEnc  String    @db.Text
  // Provider-specific delta marker. Google: events.list syncToken.
  // Microsoft: calendarView/delta deltaLink. Null on first run; populated
  // after the first successful sync. Provider can invalidate (Google 410);
  // we drop and re-bootstrap on the next notification.
  syncToken      String?   @db.Text
  expiresAt      DateTime
  lastRenewedAt  DateTime?
  // Google's monotonic message counter. We refuse to process a notification
  // whose number is <= this value — that's a duplicate redelivery. MS
  // doesn't have an equivalent (different idempotency strategy via
  // notification id ring-buffer if needed).
  lastMessageNum Int?
  status         String    @default("active") // active | expired | error
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([expiresAt, status])
  @@index([connectionId])
}

model CalendarEvent {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  description    String    @default("") @db.Text
  startTime      DateTime
  endTime        DateTime
